  Set loads_clg_roofs = loads_clg_roofs + (-hr_roofs * clg_mode * 1), !- Program Line 154
  Set loads_clg_windows_conduction = loads_clg_windows_conduction + (-hr_windows_conduction * clg_mode * 1), !- Program Line 155

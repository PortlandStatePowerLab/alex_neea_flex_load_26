  {dabeffac-2cfd-49c6-8dac-27ebaffcf6a1}, !- Handle
  fridge_schedule_act,                    !- Name
  {9f30f3cf-c499-4f9b-b8bc-387d23ab0ad9}, !- Actuated Component Name

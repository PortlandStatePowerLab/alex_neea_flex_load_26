  Set fridge_schedule_1_act = (-0.091+0.017*Tin), !- Program Line 40
  ElseIf (Hour == 19),                    !- Program Line 41
  Set fridge_schedule_1_act = (-0.077+0.014*Tin), !- Program Line 42
  ElseIf (Hour == 20),                    !- Program Line 43
  Set fridge_schedule_1_act = (-0.118+0.016*Tin), !- Program Line 44
  ElseIf (Hour == 21),                    !- Program Line 45
  Set fridge_schedule_1_act = (-0.247+0.017*Tin), !- Program Line 46
  ElseIf (Hour == 22),                    !- Program Line 47
  Set fridge_schedule_1_act = (-0.445+0.019*Tin), !- Program Line 48
  ElseIf (Hour == 23),                    !- Program Line 49
  Set fridge_schedule_1_act = (-0.544+0.02*Tin), !- Program Line 50
  EndIf;                                  !- Program Line 51


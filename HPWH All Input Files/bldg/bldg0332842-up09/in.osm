  Set loads_htg_ducts = 0,                !- Program Line 20
  Set loads_clg_walls = 0,                !- Program Line 21
  Set loads_clg_rim_joists = 0,           !- Program Line 22
  Set loads_clg_foundation_walls = 0,     !- Program Line 23
  Set loads_clg_floors = 0,               !- Program Line 24
  Set loads_clg_slabs = 0,                !- Program Line 25
  Set loads_clg_ceilings = 0,             !- Program Line 26
  Set loads_clg_roofs = 0,                !- Program Line 27
  Set loads_clg_windows_conduction = 0,   !- Program Line 28
  Set loads_clg_windows_solar = 0,        !- Program Line 29
  Set loads_clg_doors = 0,                !- Program Line 30
  Set loads_clg_skylights_conduction = 0, !- Program Line 31
  Set loads_clg_skylights_solar = 0,      !- Program Line 32
  Set loads_clg_internal_mass = 0,        !- Program Line 33
  Set loads_clg_intgains = 0,             !- Program Line 34
  Set loads_clg_lighting = 0,             !- Program Line 35
  Set loads_clg_infil = 0,                !- Program Line 36
  Set loads_clg_mechvent = 0,             !- Program Line 37
  Set loads_clg_natvent = 0,              !- Program Line 38
  Set loads_clg_whf = 0,                  !- Program Line 39
  Set loads_clg_ducts = 0,                !- Program Line 40
  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_9 + s_ig_9 + s_sol_9 + s_lgt_9 + s_surf_9, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_10 + s_ig_10 + s_sol_10 + s_lgt_10 + s_surf_10, !- Program Line 43
  Set hr_walls = hr_walls + s_conv_11 + s_ig_11 + s_sol_11 + s_lgt_11 + s_surf_11, !- Program Line 44
  Set hr_walls = hr_walls + s_conv_12 + s_ig_12 + s_sol_12 + s_lgt_12 + s_surf_12, !- Program Line 45
  Set hr_rim_joists = 0,                  !- Program Line 46
  Set hr_rim_joists = hr_rim_joists + s_conv_4 + s_ig_4 + s_sol_4 + s_lgt_4 + s_surf_4, !- Program Line 47
  Set hr_rim_joists = hr_rim_joists + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 48
  Set hr_rim_joists = hr_rim_joists + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 49
  Set hr_rim_joists = hr_rim_joists + s_conv_7 + s_ig_7 + s_sol_7 + s_lgt_7 + s_surf_7, !- Program Line 50
  Set hr_foundation_walls = 0,            !- Program Line 51
  Set hr_foundation_walls = hr_foundation_walls + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 52
  Set hr_floors = 0,                      !- Program Line 53
  Set hr_slabs = 0,                       !- Program Line 54
  Set hr_slabs = hr_slabs + s_conv_8 + s_ig_8 + s_sol_8 + s_lgt_8 + s_surf_8, !- Program Line 55
  Set hr_ceilings = 0,                    !- Program Line 56
  Set hr_ceilings = hr_ceilings + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 57
  Set hr_roofs = 0,                       !- Program Line 58
  Set hr_windows_conduction = 0,          !- Program Line 59
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 60
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_1, !- Program Line 61
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_1, !- Program Line 62
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_2, !- Program Line 63
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_2, !- Program Line 64
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_2, !- Program Line 65
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_3, !- Program Line 66
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_3, !- Program Line 67
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_3, !- Program Line 68
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_4, !- Program Line 69
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_4, !- Program Line 70
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 71
  Set hr_windows_solar = 0,               !- Program Line 72
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 73
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_1 * ZoneTimestep * 3600 + ss_back_out_1 * ZoneTimestep * 3600 + ss_trans_out_1 * ZoneTimestep * 3600, !- Program Line 74
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_2 * ZoneTimestep * 3600 + ss_back_out_2 * ZoneTimestep * 3600 + ss_trans_out_2 * ZoneTimestep * 3600, !- Program Line 75
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_3 * ZoneTimestep * 3600 + ss_back_out_3 * ZoneTimestep * 3600 + ss_trans_out_3 * ZoneTimestep * 3600, !- Program Line 76
  Set hr_doors = 0,                       !- Program Line 77
  Set hr_doors = hr_doors + ss_sol,       !- Program Line 78
  Set hr_doors = hr_doors + ss_lgt,       !- Program Line 79
  Set hr_doors = hr_doors + ss_conv,      !- Program Line 80
  Set hr_doors = hr_doors + ss_ig,        !- Program Line 81
  Set hr_doors = hr_doors + ss_surf,      !- Program Line 82
  Set hr_skylights_conduction = 0,        !- Program Line 83
  Set hr_skylights_solar = 0,             !- Program Line 84
  Set hr_internal_mass = 0,               !- Program Line 85
  Set hr_internal_mass = hr_internal_mass + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 86
  Set hr_internal_mass = hr_internal_mass + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 87
  Set hr_internal_mass = hr_internal_mass + im_conv + im_ig + im_sol + im_lgt + im_surf, !- Program Line 88
  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 89
  Set hr_intgains = 0,                    !- Program Line 90
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_ee_conv_6 - ig_ee_rad_6 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_oe_conv_6 - ig_oe_rad_6 - ig_ppl_conv - ig_ppl_rad, !- Program Line 91
  Set hr_lighting = 0,                    !- Program Line 92
  Set hr_lighting = hr_lighting - ig_lgt_conv - ig_lgt_rad - ig_lgt_vis, !- Program Line 93
  Set hr_infil = 0,                       !- Program Line 94
  Set hr_infil = hr_infil - airflow_gain + airflow_loss, !- Program Line 95
  Set hr_natvent = 0,                     !- Program Line 96
  Set hr_natvent = hr_natvent - airflow_gain_1 + airflow_loss_1, !- Program Line 97
  Set hr_whf = 0,                         !- Program Line 98
  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 99
  Set hr_mechvent = 0,                    !- Program Line 100
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 101
  Set hr_ducts = 0,                       !- Program Line 102
  Set htg_mode = 0,                       !- Program Line 103
  Set clg_mode = 0,                       !- Program Line 104
  If (htg_load_cond > 0),                 !- Program Line 105
  Set htg_mode = 1.0,                     !- Program Line 106
  ElseIf (clg_load_cond > 0),             !- Program Line 107
  Set clg_mode = 1.0,                     !- Program Line 108
  Else,                                   !- Program Line 109
  Set htg_season = 0,                     !- Program Line 110
  Set clg_season = 0,                     !- Program Line 111
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 112
  Set clg_season = 1,                     !- Program Line 113
  EndIf,                                  !- Program Line 114
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 115
  Set htg_season = 1,                     !- Program Line 116
  EndIf,                                  !- Program Line 117
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 118
  Set clg_mode = 1.0,                     !- Program Line 119
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 120
  Set clg_mode = 1.0,                     !- Program Line 121
  Else,                                   !- Program Line 122
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 123
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 124
  Set clg_mode = 1.0,                     !- Program Line 125
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 126
  Set htg_mode = 1.0,                     !- Program Line 127
  EndIf,                                  !- Program Line 128
  EndIf,                                  !- Program Line 129
  EndIf,                                  !- Program Line 130
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 131
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 132
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 133
  Set loads_htg_floors = loads_htg_floors + (hr_floors * htg_mode * 1), !- Program Line 134
  Set loads_htg_slabs = loads_htg_slabs + (hr_slabs * htg_mode * 1), !- Program Line 135
  Set loads_htg_ceilings = loads_htg_ceilings + (hr_ceilings * htg_mode * 1), !- Program Line 136

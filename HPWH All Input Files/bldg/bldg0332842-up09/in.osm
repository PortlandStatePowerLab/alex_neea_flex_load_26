  {36c031ce-e930-4fd9-9dbf-29675d56e79b}, !- Handle
  {f6a3088c-1b92-44f5-89dd-eefb53906986}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1


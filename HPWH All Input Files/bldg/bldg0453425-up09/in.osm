OS:EnergyManagementSystem:Actuator,
  {a42d5ff8-add1-44eb-97eb-bbddcee8c2ca}, !- Handle
  fridge_schedule_act,                    !- Name
  {1bd544ae-3ce7-4781-95ca-0a402ee07dfb}, !- Actuated Component Name

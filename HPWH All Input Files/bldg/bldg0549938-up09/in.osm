  Set hr_windows_solar = 0,               !- Program Line 85
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 86
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_1 * ZoneTimestep * 3600 + ss_back_out_1 * ZoneTimestep * 3600 + ss_trans_out_1 * ZoneTimestep * 3600, !- Program Line 87
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_2 * ZoneTimestep * 3600 + ss_back_out_2 * ZoneTimestep * 3600 + ss_trans_out_2 * ZoneTimestep * 3600, !- Program Line 88
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_3 * ZoneTimestep * 3600 + ss_back_out_3 * ZoneTimestep * 3600 + ss_trans_out_3 * ZoneTimestep * 3600, !- Program Line 89
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_4 * ZoneTimestep * 3600 + ss_back_out_4 * ZoneTimestep * 3600 + ss_trans_out_4 * ZoneTimestep * 3600, !- Program Line 90

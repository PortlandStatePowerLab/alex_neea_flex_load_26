  Set htg_season = 0,                     !- Program Line 130
  Set clg_season = 0,                     !- Program Line 131
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 132
  Set clg_season = 1,                     !- Program Line 133
  EndIf,                                  !- Program Line 134
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 135
  Set htg_season = 1,                     !- Program Line 136
  EndIf,                                  !- Program Line 137
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 138
  Set clg_mode = 1.0,                     !- Program Line 139
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 140
  Set clg_mode = 1.0,                     !- Program Line 141

  Set hr_windows_solar = hr_windows_solar - ss_trans_in_6 * ZoneTimestep * 3600 + ss_back_out_6 * ZoneTimestep * 3600 + ss_trans_out_6 * ZoneTimestep * 3600, !- Program Line 92
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_7 * ZoneTimestep * 3600 + ss_back_out_7 * ZoneTimestep * 3600 + ss_trans_out_7 * ZoneTimestep * 3600, !- Program Line 93
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_8 * ZoneTimestep * 3600 + ss_back_out_8 * ZoneTimestep * 3600 + ss_trans_out_8 * ZoneTimestep * 3600, !- Program Line 94
  Set hr_doors = 0,                       !- Program Line 95
  Set hr_doors = hr_doors + ss_sol,       !- Program Line 96
  Set hr_doors = hr_doors + ss_lgt,       !- Program Line 97

  mech_vent_house_fan_cfis_act,           !- Name
  {b41639cf-8c3d-4f8f-acd5-142bb752ca90}, !- Actuated Component Name
  ElectricEquipment,                      !- Actuated Component Type
  Electricity Rate,                       !- Actuated Component Control Type

  {d43e9d4e-2257-45b6-afc8-615635c236fd}, !- Handle
  soc_sensor,                             !- Name
  Vehicle1 li ion,                        !- Output Variable or Output Meter Index Key Name
  Electric Storage Charge Fraction;       !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Program,
  {a51947b1-29ab-4a59-845e-557ceec2dd23}, !- Handle
  ev_discharge_program,                   !- Name
  Set power_mult = (1.412768*(site_temp_adj^0))+(-0.03910397*(site_temp_adj^1))+(0.0009408235*(site_temp_adj^2))+(8.97156e-06*(site_temp_adj^3))+(-7.699244e-07*(site_temp_adj^4))+(1.265614e-08*(site_temp_adj^5)), !- Program Line 1
  Set site_temp_adj = site_temp,          !- Program Line 2
  If site_temp < -17.778,                 !- Program Line 3
  Set site_temp_adj = -17.778,            !- Program Line 4
  ElseIf site_temp > 37.778,              !- Program Line 5
  Set site_temp_adj = 37.778,             !- Program Line 6
  EndIf,                                  !- Program Line 7
  If discharge_sch_sensor > 0.0,          !- Program Line 8
  Set battery_discharge_power_act = 5047.543802124861 * 1.0 * power_mult * discharge_sch_sensor, !- Program Line 9
  Set battery_charge_power_act = 5690 * charge_sch_sensor, !- Program Line 10
  If soc_sensor <= 0.149990831295843,     !- Program Line 11
  Set unmet_driving_hours = discharge_sch_sensor, !- Program Line 12
  Else,                                   !- Program Line 13
  Set unmet_driving_hours = 0,            !- Program Line 14
  EndIf,                                  !- Program Line 15
  Else,                                   !- Program Line 16
  Set battery_charge_power_act = 5690 * charge_sch_sensor, !- Program Line 17
  Set battery_discharge_power_act = 0,    !- Program Line 18
  Set unmet_driving_hours = 0,            !- Program Line 19
  EndIf;                                  !- Program Line 20


  {95c9c600-6236-4356-84c2-3dec4ee1b78c}, !- Handle
  mech_vent_house_fan_cfis_act,           !- Name
  {872d230f-e3fa-443e-b177-2e13a9c9f341}, !- Actuated Component Name
  ElectricEquipment,                      !- Actuated Component Type

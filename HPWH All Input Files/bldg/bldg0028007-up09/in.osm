  {e85440fa-a91f-4340-b2df-ea8a83b64371}, !- Handle
  Vehicle1 li ion,                        !- Name
  {ef26c15a-9005-413a-87bc-09c21d9b285a}, !- Availability Schedule Name
  ,                                       !- Zone Name
  0,                                      !- Radiative Fraction
  None,                                   !- Lifetime Model
  15,                                     !- Number of Cells in Series
  652,                                    !- Number of Strings in Parallel
  0.95,                                   !- Initial Fractional State of Charge
  1,                                      !- DC to DC Charging Efficiency
  1035.54,                                !- Battery Mass {kg}
  6.7932231798576,                        !- Battery Surface Area {m2}
  1500,                                   !- Battery Specific Heat Capacity {J/kg-K}
  7.5,                                    !- Heat Transfer Coefficient Between Battery and Ambient {W/m2-K}
  3.342,                                  !- Fully Charged Cell Voltage {V}
  3.342,                                  !- Cell Voltage at End of Exponential Zone {V}
  3.342,                                  !- Cell Voltage at End of Nominal Zone {V}
  3.342,                                  !- Default Nominal Cell Voltage {V}
  3.2,                                    !- Fully Charged Cell Capacity {Ah}
  0.8075,                                 !- Fraction of Cell Capacity Removed at the End of Exponential Zone

  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 126
  Set htg_season = 1,                     !- Program Line 127
  EndIf,                                  !- Program Line 128
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 129
  Set clg_mode = 1.0,                     !- Program Line 130

OS:EnergyManagementSystem:Program,
  {e4395585-0646-4d76-bddd-48d235763df9}, !- Handle
  water_heater_InletAir,                  !- Name
  Set water_heater_Tamb_act = water_heater_amb_temp, !- Program Line 1
  Set water_heater_RHamb_act = 0,         !- Program Line 2
  Set water_heater_RHamb_act = water_heater_RHamb_act + (water_heater_amb_rh / 100) / 1, !- Program Line 3
  Set water_heater_sens_act = (0 - water_heater_sens_cool - (water_heater_tl + water_heater_fan_pwr)) / 1, !- Program Line 4
  Set water_heater_lat_act = (0 - water_heater_lat_cool) / 1; !- Program Line 5


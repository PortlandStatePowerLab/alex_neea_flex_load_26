OS:EnergyManagementSystem:Actuator,
  {4634d502-17f2-42f0-be33-33a1dd7157e5}, !- Handle
  fridge_schedule_act,                    !- Name
  {b539eb7b-ea13-4738-8a03-2c5d2869d3ba}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {6726ad6e-df59-4478-8e4b-b4236505be16}, !- Handle
  fridge_schedule_act,                    !- Name
  {2fdca5ff-2946-42ee-879d-f8446e2c7df5}, !- Actuated Component Name

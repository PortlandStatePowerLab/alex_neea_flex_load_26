  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_9 + s_ig_9 + s_sol_9 + s_lgt_9 + s_surf_9, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_10 + s_ig_10 + s_sol_10 + s_lgt_10 + s_surf_10, !- Program Line 43

  Set loads_clg_roofs = 0,                !- Program Line 27
  Set loads_clg_windows_conduction = 0,   !- Program Line 28
  Set loads_clg_windows_solar = 0,        !- Program Line 29
  Set loads_clg_doors = 0,                !- Program Line 30
  Set loads_clg_skylights_conduction = 0, !- Program Line 31
  Set loads_clg_skylights_solar = 0,      !- Program Line 32

  Set hr_rim_joists = hr_rim_joists + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 49
  Set hr_rim_joists = hr_rim_joists + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 50
  Set hr_foundation_walls = 0,            !- Program Line 51
  Set hr_foundation_walls = hr_foundation_walls + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 52

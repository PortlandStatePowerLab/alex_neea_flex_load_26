OS:EnergyManagementSystem:ProgramCallingManager,
  {dad2daf7-4575-4b12-b47b-b48d86a10688}, !- Handle
  component_loads_program_calling_manager, !- Name
  EndOfZoneTimestepAfterZoneReporting,    !- EnergyPlus Model Calling Point
  {18964fba-0fb9-450a-86a5-2a46b5da6262}; !- Program Name 1

OS:EnergyManagementSystem:Program,
  {9aece4b1-60a5-463a-a5f6-771dfd846d5c}, !- Handle
  total_airflows_program,                 !- Name
  Set total_infil_flow_rate = 0,          !- Program Line 1
  Set total_mechvent_flow_rate = 0,       !- Program Line 2
  Set total_natvent_flow_rate = 0,        !- Program Line 3
  Set total_whf_flow_rate = 0,            !- Program Line 4
  Set total_infil_flow_rate = total_infil_flow_rate + (infil_program_Qinf * 1), !- Program Line 5
  Set total_mechvent_flow_rate = total_mechvent_flow_rate + (infil_program_Qfan * 1), !- Program Line 6
  Set total_natvent_flow_rate = total_natvent_flow_rate + (natural_vent_program_Qnv * 1), !- Program Line 7
  Set total_whf_flow_rate = total_whf_flow_rate + (natural_vent_program_Qwhf * 1); !- Program Line 8

OS:AdditionalProperties,
  {2803c109-0384-42b0-afd6-3376e103e4a9}, !- Handle
  {9aece4b1-60a5-463a-a5f6-771dfd846d5c}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  total airflows program;                 !- Feature Value 1


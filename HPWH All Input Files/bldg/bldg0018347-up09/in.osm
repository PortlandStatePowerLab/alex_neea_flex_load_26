  Heating:EnergyTransfer:Zone:FURNACE AIRLOOP RET AIR ZONE; !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Sensor,
  {80e45a90-f904-48f2-9ef4-2e3dc3d4ead6}, !- Handle

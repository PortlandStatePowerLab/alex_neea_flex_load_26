  Set hr_windows_solar = hr_windows_solar - ss_trans_in_5 * ZoneTimestep * 3600 + ss_back_out_5 * ZoneTimestep * 3600 + ss_trans_out_5 * ZoneTimestep * 3600, !- Program Line 85
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_6 * ZoneTimestep * 3600 + ss_back_out_6 * ZoneTimestep * 3600 + ss_trans_out_6 * ZoneTimestep * 3600, !- Program Line 86
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_7 * ZoneTimestep * 3600 + ss_back_out_7 * ZoneTimestep * 3600 + ss_trans_out_7 * ZoneTimestep * 3600, !- Program Line 87

OS:EnergyManagementSystem:Program,
  {48615ce0-09e5-4572-b4b0-bfa677245674}, !- Handle
  component_loads_program,                !- Name
  Set loads_htg_walls = 0,                !- Program Line 1
  Set loads_htg_rim_joists = 0,           !- Program Line 2
  Set loads_htg_foundation_walls = 0,     !- Program Line 3
  Set loads_htg_floors = 0,               !- Program Line 4
  Set loads_htg_slabs = 0,                !- Program Line 5
  Set loads_htg_ceilings = 0,             !- Program Line 6
  Set loads_htg_roofs = 0,                !- Program Line 7
  Set loads_htg_windows_conduction = 0,   !- Program Line 8
  Set loads_htg_windows_solar = 0,        !- Program Line 9
  Set loads_htg_doors = 0,                !- Program Line 10
  Set loads_htg_skylights_conduction = 0, !- Program Line 11
  Set loads_htg_skylights_solar = 0,      !- Program Line 12
  Set loads_htg_internal_mass = 0,        !- Program Line 13
  Set loads_htg_intgains = 0,             !- Program Line 14
  Set loads_htg_lighting = 0,             !- Program Line 15
  Set loads_htg_infil = 0,                !- Program Line 16
  Set loads_htg_mechvent = 0,             !- Program Line 17

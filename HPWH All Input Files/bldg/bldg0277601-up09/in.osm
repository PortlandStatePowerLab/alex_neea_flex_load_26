OS:EnergyManagementSystem:Actuator,
  {aa3646f6-bef2-4d12-ba6c-5487cb92171e}, !- Handle
  fridge_schedule_act,                    !- Name
  {0fc67bde-5d82-43fe-bc21-9af530eedc14}, !- Actuated Component Name

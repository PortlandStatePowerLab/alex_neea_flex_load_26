  Set hr_rim_joists = 0,                  !- Program Line 46
  Set hr_foundation_walls = 0,            !- Program Line 47
  Set hr_floors = 0,                      !- Program Line 48
  Set hr_floors = hr_floors + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 49
  Set hr_slabs = 0,                       !- Program Line 50
  Set hr_ceilings = 0,                    !- Program Line 51
  Set hr_roofs = 0,                       !- Program Line 52
  Set hr_roofs = hr_roofs + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 53
  Set hr_windows_conduction = 0,          !- Program Line 54
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 55
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_1, !- Program Line 56
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_1, !- Program Line 57

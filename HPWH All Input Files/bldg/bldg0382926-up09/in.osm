  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 82
  Set hr_intgains = 0,                    !- Program Line 83
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_ee_conv_6 - ig_ee_rad_6 - ig_ee_conv_7 - ig_ee_rad_7 - ig_ee_conv_8 - ig_ee_rad_8 - ig_ee_conv_9 - ig_ee_rad_9 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_oe_conv_6 - ig_oe_rad_6 - ig_ppl_conv - ig_ppl_rad, !- Program Line 84
  Set hr_lighting = 0,                    !- Program Line 85

  Set loads_clg_ducts = 0,                !- Program Line 40
  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 43
  Set hr_walls = hr_walls + s_conv_4 + s_ig_4 + s_sol_4 + s_lgt_4 + s_surf_4, !- Program Line 44
  Set hr_walls = hr_walls + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 45
  Set hr_walls = hr_walls + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 46
  Set hr_walls = hr_walls + s_conv_7 + s_ig_7 + s_sol_7 + s_lgt_7 + s_surf_7, !- Program Line 47
  Set hr_rim_joists = 0,                  !- Program Line 48
  Set hr_foundation_walls = 0,            !- Program Line 49
  Set hr_floors = 0,                      !- Program Line 50
  Set hr_floors = hr_floors + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 51
  Set hr_slabs = 0,                       !- Program Line 52
  Set hr_ceilings = 0,                    !- Program Line 53
  Set hr_roofs = 0,                       !- Program Line 54
  Set hr_roofs = hr_roofs + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 55
  Set hr_windows_conduction = 0,          !- Program Line 56
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 57
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_1, !- Program Line 58
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_1, !- Program Line 59

OS:EnergyManagementSystem:Actuator,
  {ff08666c-d4d6-46b0-b76d-58327e1a39d8}, !- Handle
  fridge_schedule_act,                    !- Name
  {c8166809-a864-46aa-aea7-1a868873d8c6}, !- Actuated Component Name

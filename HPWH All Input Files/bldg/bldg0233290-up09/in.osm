  {3ea00d43-dc9a-435a-b6e8-d0cd30d0a078}, !- Handle
  fridge_schedule_act,                    !- Name
  {0fefb79c-c449-4a89-adb3-f3a421e9b0c9}, !- Actuated Component Name

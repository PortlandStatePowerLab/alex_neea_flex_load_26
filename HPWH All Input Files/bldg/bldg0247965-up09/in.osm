  ElseIf (Hour == 9),                     !- Program Line 21
  Set fridge_schedule_1_act = (-0.417+0.019*Tin), !- Program Line 22
  ElseIf (Hour == 10),                    !- Program Line 23
  Set fridge_schedule_1_act = (-0.411+0.018*Tin), !- Program Line 24

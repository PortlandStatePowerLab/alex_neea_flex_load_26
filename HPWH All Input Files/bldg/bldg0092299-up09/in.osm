  Set hr_ducts = 0,                       !- Program Line 97
  Set htg_mode = 0,                       !- Program Line 98
  Set clg_mode = 0,                       !- Program Line 99
  If (htg_load_cond > 0),                 !- Program Line 100
  Set htg_mode = 1.0,                     !- Program Line 101
  ElseIf (clg_load_cond > 0),             !- Program Line 102
  Set clg_mode = 0.0,                     !- Program Line 103
  Else,                                   !- Program Line 104
  Set htg_season = 0,                     !- Program Line 105
  Set clg_season = 0,                     !- Program Line 106
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 107
  Set clg_season = 1,                     !- Program Line 108
  EndIf,                                  !- Program Line 109
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 110
  Set htg_season = 1,                     !- Program Line 111
  EndIf,                                  !- Program Line 112
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 113
  Set clg_mode = 0.0,                     !- Program Line 114
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 115
  Set clg_mode = 0.0,                     !- Program Line 116
  Else,                                   !- Program Line 117
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 118

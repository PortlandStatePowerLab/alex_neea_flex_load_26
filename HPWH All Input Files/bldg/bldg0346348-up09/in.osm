OS:EnergyManagementSystem:Actuator,
  {a06ebe62-1cf9-4a80-9e89-0898d3204593}, !- Handle
  fridge_schedule_act,                    !- Name
  {3622152c-bc00-4f93-bf87-fc3ad067d883}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {1940d778-4f49-40b5-b486-426eb492e33a}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {00bbb10f-52f6-4582-bc5d-39c0019f36d1}, !- Actuated Component Name
  OtherEquipment,                         !- Actuated Component Type
  Power Level,                            !- Actuated Component Control Type

OS:EnergyManagementSystem:Actuator,
  {7d584e67-6ff2-4e77-a326-08ab4be6013c}, !- Handle
  fridge_schedule_act,                    !- Name
  {7556a04d-8b3a-423d-9efc-97ba583ce799}, !- Actuated Component Name

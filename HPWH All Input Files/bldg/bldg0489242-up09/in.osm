OS:EnergyManagementSystem:Subroutine,
  {9bbe8333-d9ec-4265-92be-0a8d83a7126a}, !- Handle
  furnace_airloop_0_duct_subroutine,      !- Name
  Set AH_MFR = furnace_airloop_AH_MFR / 1, !- Program Line 1
  If AH_MFR > 0,                          !- Program Line 2
  Set AH_Tout = furnace_airloop_AH_Tout,  !- Program Line 3
  Set AH_Wout = furnace_airloop_AH_Wout,  !- Program Line 4
  Set RA_T = furnace_airloop_RA_T,        !- Program Line 5
  Set RA_W = furnace_airloop_Ra_W,        !- Program Line 6
  Set Fan_RTF = furnace_airloop_Fan_RTF,  !- Program Line 7
  Set DZ_T = furnace_airloop_0_DZ_T,      !- Program Line 8
  Set DZ_W = furnace_airloop_0_DZ_W,      !- Program Line 9
  Set AH_VFR = furnace_airloop_AH_VFR / 1, !- Program Line 10
  Set h_SA = (@HFnTdbW AH_Tout AH_Wout),  !- Program Line 11
  Set h_RA = (@HFnTdbW RA_T RA_W),        !- Program Line 12
  Set h_fg = (@HfgAirFnWTdb AH_Wout AH_Tout), !- Program Line 13
  Set h_DZ = (@HFnTdbW DZ_T DZ_W),        !- Program Line 14
  Set air_cp = 1006.0,                    !- Program Line 15
  Set f_sup = 0.2,                        !- Program Line 16
  Set f_ret = 0.1,                        !- Program Line 17
  Set sup_lk_mfr = f_sup * AH_MFR,        !- Program Line 18
  Set ret_lk_mfr = f_ret * AH_MFR,        !- Program Line 19
  Set SupTotLkToCond = sup_lk_mfr*(h_RA - h_SA), !- Program Line 20
  Set SupLatLkToCond = sup_lk_mfr*h_fg*(RA_W-AH_Wout), !- Program Line 21
  Set SupSensLkToCond = SupTotLkToCond-SupLatLkToCond, !- Program Line 22
  Set supply_ua = 87.081,                 !- Program Line 23
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*supply_ua), !- Program Line 24
  Set t_sup = DZ_T+((AH_Tout-DZ_T)*(@Exp eTm)), !- Program Line 25
  Set SupCondToCond = AH_MFR*air_cp*(t_sup-AH_Tout), !- Program Line 26
  Set SupCondToDZ = 0-SupCondToCond,      !- Program Line 27
  Set return_ua = 14.126,                 !- Program Line 28
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*return_ua), !- Program Line 29
  Set t_ret = DZ_T+((RA_T-DZ_T)*(@Exp eTm)), !- Program Line 30
  Set RetCondToRP = AH_MFR*air_cp*(t_ret-RA_T), !- Program Line 31
  Set RetCondToDZ = 0-RetCondToRP,        !- Program Line 32
  Set RetLatLkToRP = 0,                   !- Program Line 33
  Set RetSensLkToRP = ret_lk_mfr*air_cp*(DZ_T-RA_T), !- Program Line 34
  Set SupTotLkToDZ = sup_lk_mfr*(h_SA-h_DZ), !- Program Line 35
  Set SupLatLkToDZ = sup_lk_mfr*h_fg*(AH_Wout-DZ_W), !- Program Line 36
  Set SupSensLkToDZ = SupTotLkToDZ-SupLatLkToDZ, !- Program Line 37
  Set FracOutsideToCond = 0.5,            !- Program Line 38
  Set FracOutsideToDZ = 0.0,              !- Program Line 39
  Set FracCondToOutside = 0.0,            !- Program Line 40
  Set FracDZToOutside = 0.5,              !- Program Line 41
  Set FracDZToCond = 0.5,                 !- Program Line 42
  Set FracCondToDZ = 0.0,                 !- Program Line 43
  Set lk_imbal_vfr = @ABS(f_sup - f_ret) * AH_VFR, !- Program Line 44
  Set ImbalLkCondToDZ = lk_imbal_vfr * FracCondToDZ, !- Program Line 45
  Set ImbalLkDZToCond = lk_imbal_vfr * FracDZToCond, !- Program Line 46
  Set ImbalLkOutsideToCond = lk_imbal_vfr * FracOutsideToCond, !- Program Line 47
  Set ImbalLkOutsideToDZ = lk_imbal_vfr * FracOutsideToDZ, !- Program Line 48
  Set ImbalLkCondToOutside = lk_imbal_vfr * FracCondToOutside, !- Program Line 49
  Set ImbalLkDZToOutside = lk_imbal_vfr * FracDZToOutside, !- Program Line 50
  Else,                                   !- Program Line 51
  Set SupLatLkToCond = 0,                 !- Program Line 52
  Set SupSensLkToCond = 0,                !- Program Line 53
  Set SupCondToCond = 0,                  !- Program Line 54
  Set RetCondToRP = 0,                    !- Program Line 55
  Set RetLatLkToRP = 0,                   !- Program Line 56
  Set RetSensLkToRP = 0,                  !- Program Line 57
  Set RetCondToDZ = 0,                    !- Program Line 58
  Set SupCondToDZ = 0,                    !- Program Line 59
  Set SupLatLkToDZ = 0,                   !- Program Line 60
  Set SupSensLkToDZ = 0,                  !- Program Line 61
  Set ImbalLkCondToDZ = 0,                !- Program Line 62
  Set ImbalLkDZToCond = 0,                !- Program Line 63
  Set ImbalLkOutsideToCond = 0,           !- Program Line 64
  Set ImbalLkOutsideToDZ = 0,             !- Program Line 65
  Set ImbalLkCondToOutside = 0,           !- Program Line 66
  Set ImbalLkDZToOutside = 0,             !- Program Line 67
  EndIf,                                  !- Program Line 68
  Set furnace_airloop_0_SupLatLkToCond = SupLatLkToCond, !- Program Line 69
  Set furnace_airloop_0_SupSensLkToCond = SupSensLkToCond, !- Program Line 70
  Set furnace_airloop_0_SupCondToLv = SupCondToCond, !- Program Line 71
  Set furnace_airloop_0_RetCondToRP = RetCondToRP, !- Program Line 72
  Set furnace_airloop_0_RetLatLkToRP = RetLatLkToRP, !- Program Line 73
  Set furnace_airloop_0_RetSensLkToRP = RetSensLkToRP, !- Program Line 74
  Set furnace_airloop_0_RetCondToDZ = RetCondToDZ, !- Program Line 75
  Set furnace_airloop_0_SupCondToDZ = SupCondToDZ, !- Program Line 76
  Set furnace_airloop_0_SupLatLkToDZ = SupLatLkToDZ, !- Program Line 77
  Set furnace_airloop_0_SupSensLkToDZ = SupSensLkToDZ, !- Program Line 78
  Set furnace_airloop_0_ZoneMixCondToDZ = ImbalLkCondToDZ, !- Program Line 79
  Set furnace_airloop_0_ZoneMixDZToCond = ImbalLkDZToCond, !- Program Line 80
  Set furnace_airloop_0_DuctImbalLkSupFanEquivCond = ImbalLkCondToOutside, !- Program Line 81

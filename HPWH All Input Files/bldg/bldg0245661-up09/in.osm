OS:EnergyManagementSystem:Actuator,
  {1de9d3a5-4248-4a1c-8a00-6391cb228f5a}, !- Handle
  fridge_schedule_act,                    !- Name
  {12795594-1e8f-4734-9510-6d117803d139}, !- Actuated Component Name

  ElseIf (Hour == 20),                    !- Program Line 43
  Set fridge_schedule_act = (-0.118+0.016*Tin), !- Program Line 44
  ElseIf (Hour == 21),                    !- Program Line 45
  Set fridge_schedule_act = (-0.247+0.017*Tin), !- Program Line 46

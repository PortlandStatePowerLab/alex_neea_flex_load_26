  water_heater_hpwh_ec_adj_act,           !- Name
  {b9bb0302-4ac4-47c4-aee2-d52a6b57d306}, !- Actuated Component Name
  OtherEquipment,                         !- Actuated Component Type
  Power Level,                            !- Actuated Component Control Type

OS:EnergyManagementSystem:Actuator,
  {e21334e1-e0ca-41e6-8a37-915fba288f65}, !- Handle
  fridge_schedule_act,                    !- Name
  {452ab047-9a29-4fe1-8ebc-e5a3f7a70612}, !- Actuated Component Name

  {c9d25f6e-2e0d-42bc-818d-0a835c3d089f}, !- Handle
  fridge_schedule_act,                    !- Name
  {d2d3d6b6-d8a5-43e4-957d-395a0e1e7ab1}, !- Actuated Component Name
  Schedule:Constant,                      !- Actuated Component Type

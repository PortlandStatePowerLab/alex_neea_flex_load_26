  Set clg_mode = 0,                       !- Program Line 99
  If (htg_load_cond > 0),                 !- Program Line 100
  Set htg_mode = 1.0,                     !- Program Line 101
  ElseIf (clg_load_cond > 0),             !- Program Line 102
  Set clg_mode = 0.2,                     !- Program Line 103
  Else,                                   !- Program Line 104
  Set htg_season = 0,                     !- Program Line 105
  Set clg_season = 0,                     !- Program Line 106
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 107

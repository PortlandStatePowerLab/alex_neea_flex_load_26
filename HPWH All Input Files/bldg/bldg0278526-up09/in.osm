OS:EnergyManagementSystem:Actuator,
  {c067cc49-716a-4740-a5e7-01dc91ed2d00}, !- Handle
  fridge_schedule_act,                    !- Name
  {7b26c279-521c-4315-901f-f8e96a6b5a0d}, !- Actuated Component Name

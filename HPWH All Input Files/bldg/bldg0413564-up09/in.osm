  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 107
  Set clg_season = 1,                     !- Program Line 108
  EndIf,                                  !- Program Line 109
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 110

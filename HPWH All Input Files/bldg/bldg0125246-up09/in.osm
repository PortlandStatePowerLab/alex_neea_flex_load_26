  Heating:EnergyTransfer:Zone:CONDITIONED SPACE; !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Sensor,
  {188398ea-38a0-4bd9-bbdf-52ad239cae0d}, !- Handle

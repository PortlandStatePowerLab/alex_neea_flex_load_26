OS:EnergyManagementSystem:Actuator,
  {09d56d9d-864a-4548-a6e3-67f90afbb925}, !- Handle
  fridge_schedule_act,                    !- Name
  {5804d81c-256b-42ff-8ec9-918d3e3d3883}, !- Actuated Component Name

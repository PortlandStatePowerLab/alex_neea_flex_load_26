OS:EnergyManagementSystem:Actuator,
  {93a9aa87-60b7-44fa-b572-7826299db010}, !- Handle
  fridge_schedule_act,                    !- Name
  {2f90d8b6-d67f-488a-aea6-bbaea9744515}, !- Actuated Component Name

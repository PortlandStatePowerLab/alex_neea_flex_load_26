OS:EnergyManagementSystem:Actuator,
  {396dee93-fc53-4eac-b660-29290e15754d}, !- Handle
  fridge_schedule_act,                    !- Name
  {bc9f0ab3-c58d-4546-aa5f-79da650b08c5}, !- Actuated Component Name

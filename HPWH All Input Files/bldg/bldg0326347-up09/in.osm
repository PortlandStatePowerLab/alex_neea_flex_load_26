  Set hr_windows_conduction = hr_windows_conduction + ss_ig_4, !- Program Line 65
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 66
  Set hr_windows_solar = 0,               !- Program Line 67
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 68
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_1 * ZoneTimestep * 3600 + ss_back_out_1 * ZoneTimestep * 3600 + ss_trans_out_1 * ZoneTimestep * 3600, !- Program Line 69
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_2 * ZoneTimestep * 3600 + ss_back_out_2 * ZoneTimestep * 3600 + ss_trans_out_2 * ZoneTimestep * 3600, !- Program Line 70
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_3 * ZoneTimestep * 3600 + ss_back_out_3 * ZoneTimestep * 3600 + ss_trans_out_3 * ZoneTimestep * 3600, !- Program Line 71
  Set hr_doors = 0,                       !- Program Line 72
  Set hr_doors = hr_doors + ss_sol,       !- Program Line 73
  Set hr_doors = hr_doors + ss_lgt,       !- Program Line 74
  Set hr_doors = hr_doors + ss_conv,      !- Program Line 75
  Set hr_doors = hr_doors + ss_ig,        !- Program Line 76
  Set hr_doors = hr_doors + ss_surf,      !- Program Line 77
  Set hr_skylights_conduction = 0,        !- Program Line 78
  Set hr_skylights_solar = 0,             !- Program Line 79
  Set hr_internal_mass = 0,               !- Program Line 80
  Set hr_internal_mass = hr_internal_mass + im_conv + im_ig + im_sol + im_lgt + im_surf, !- Program Line 81
  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 82
  Set hr_intgains = 0,                    !- Program Line 83
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_ee_conv_6 - ig_ee_rad_6 - ig_ee_conv_7 - ig_ee_rad_7 - ig_ee_conv_8 - ig_ee_rad_8 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_oe_conv_6 - ig_oe_rad_6 - ig_ppl_conv - ig_ppl_rad, !- Program Line 84
  Set hr_lighting = 0,                    !- Program Line 85
  Set hr_lighting = hr_lighting - ig_lgt_conv - ig_lgt_rad - ig_lgt_vis, !- Program Line 86
  Set hr_infil = 0,                       !- Program Line 87
  Set hr_infil = hr_infil - airflow_gain + airflow_loss, !- Program Line 88
  Set hr_natvent = 0,                     !- Program Line 89
  Set hr_natvent = hr_natvent - airflow_gain_1 + airflow_loss_1, !- Program Line 90
  Set hr_whf = 0,                         !- Program Line 91
  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 92
  Set hr_mechvent = 0,                    !- Program Line 93
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 94
  Set hr_ducts = 0,                       !- Program Line 95
  Set htg_mode = 0,                       !- Program Line 96
  Set clg_mode = 0,                       !- Program Line 97
  If (htg_load_cond > 0),                 !- Program Line 98
  Set htg_mode = 1.0,                     !- Program Line 99
  ElseIf (clg_load_cond > 0),             !- Program Line 100
  Set clg_mode = 0.0,                     !- Program Line 101
  Else,                                   !- Program Line 102
  Set htg_season = 0,                     !- Program Line 103
  Set clg_season = 0,                     !- Program Line 104
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 105
  Set clg_season = 1,                     !- Program Line 106
  EndIf,                                  !- Program Line 107
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 108
  Set htg_season = 1,                     !- Program Line 109
  EndIf,                                  !- Program Line 110
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 111
  Set clg_mode = 0.0,                     !- Program Line 112
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 113
  Set clg_mode = 0.0,                     !- Program Line 114
  Else,                                   !- Program Line 115
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 116
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 117
  Set clg_mode = 0.0,                     !- Program Line 118
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 119
  Set htg_mode = 1.0,                     !- Program Line 120
  EndIf,                                  !- Program Line 121
  EndIf,                                  !- Program Line 122
  EndIf,                                  !- Program Line 123
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 124
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 125
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 126
  Set loads_htg_floors = loads_htg_floors + (hr_floors * htg_mode * 1), !- Program Line 127
  Set loads_htg_slabs = loads_htg_slabs + (hr_slabs * htg_mode * 1), !- Program Line 128
  Set loads_htg_ceilings = loads_htg_ceilings + (hr_ceilings * htg_mode * 1), !- Program Line 129
  Set loads_htg_roofs = loads_htg_roofs + (hr_roofs * htg_mode * 1), !- Program Line 130
  Set loads_htg_windows_conduction = loads_htg_windows_conduction + (hr_windows_conduction * htg_mode * 1), !- Program Line 131
  Set loads_htg_windows_solar = loads_htg_windows_solar + (hr_windows_solar * htg_mode * 1), !- Program Line 132
  Set loads_htg_doors = loads_htg_doors + (hr_doors * htg_mode * 1), !- Program Line 133
  Set loads_htg_skylights_conduction = loads_htg_skylights_conduction + (hr_skylights_conduction * htg_mode * 1), !- Program Line 134
  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 135
  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 136
  Set loads_htg_intgains = loads_htg_intgains + (hr_intgains * htg_mode * 1), !- Program Line 137
  Set loads_htg_lighting = loads_htg_lighting + (hr_lighting * htg_mode * 1), !- Program Line 138
  Set loads_htg_infil = loads_htg_infil + (hr_infil * htg_mode * 1), !- Program Line 139
  Set loads_htg_mechvent = loads_htg_mechvent + (hr_mechvent * htg_mode * 1), !- Program Line 140
  Set loads_htg_natvent = loads_htg_natvent + (hr_natvent * htg_mode * 1), !- Program Line 141
  Set loads_htg_whf = loads_htg_whf + (hr_whf * htg_mode * 1), !- Program Line 142
  Set loads_htg_ducts = loads_htg_ducts + (hr_ducts * htg_mode * 1), !- Program Line 143
  Set loads_clg_walls = loads_clg_walls + (-hr_walls * clg_mode * 1), !- Program Line 144
  Set loads_clg_rim_joists = loads_clg_rim_joists + (-hr_rim_joists * clg_mode * 1), !- Program Line 145
  Set loads_clg_foundation_walls = loads_clg_foundation_walls + (-hr_foundation_walls * clg_mode * 1), !- Program Line 146
  Set loads_clg_floors = loads_clg_floors + (-hr_floors * clg_mode * 1), !- Program Line 147

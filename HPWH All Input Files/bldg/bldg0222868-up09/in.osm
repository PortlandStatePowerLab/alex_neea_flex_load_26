  Set hr_doors = hr_doors + ss_ig,        !- Program Line 92
  Set hr_doors = hr_doors + ss_surf,      !- Program Line 93
  Set hr_skylights_conduction = 0,        !- Program Line 94
  Set hr_skylights_solar = 0,             !- Program Line 95
  Set hr_internal_mass = 0,               !- Program Line 96
  Set hr_internal_mass = hr_internal_mass + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 97
  Set hr_internal_mass = hr_internal_mass + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 98
  Set hr_internal_mass = hr_internal_mass + im_conv + im_ig + im_sol + im_lgt + im_surf, !- Program Line 99
  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 100
  Set hr_intgains = 0,                    !- Program Line 101
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_ee_conv_6 - ig_ee_rad_6 - ig_ee_conv_7 - ig_ee_rad_7 - ig_ee_conv_8 - ig_ee_rad_8 - ig_ee_conv_9 - ig_ee_rad_9 - ig_ee_conv_10 - ig_ee_rad_10 - ig_ee_conv_11 - ig_ee_rad_11 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_oe_conv_6 - ig_oe_rad_6 - ig_ppl_conv - ig_ppl_rad, !- Program Line 102
  Set hr_lighting = 0,                    !- Program Line 103
  Set hr_lighting = hr_lighting - ig_lgt_conv - ig_lgt_rad - ig_lgt_vis, !- Program Line 104
  Set hr_infil = 0,                       !- Program Line 105
  Set hr_infil = hr_infil - airflow_gain + airflow_loss, !- Program Line 106
  Set hr_natvent = 0,                     !- Program Line 107
  Set hr_natvent = hr_natvent - airflow_gain_1 + airflow_loss_1, !- Program Line 108
  Set hr_whf = 0,                         !- Program Line 109
  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 110
  Set hr_mechvent = 0,                    !- Program Line 111
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 112
  Set hr_ducts = 0,                       !- Program Line 113
  Set hr_ducts = hr_ducts - ducts_conv - ducts_rad - ducts_conv_1 - ducts_rad_1 - ducts_conv_2 - ducts_rad_2 - ducts_conv_3 - ducts_rad_3 - ducts_conv_4 - ducts_rad_4 - ducts_conv_5 - ducts_rad_5, !- Program Line 114
  Set hr_ducts = hr_ducts + (duct_mix_loss_1 - duct_mix_gain_1), !- Program Line 115
  Set htg_mode = 0,                       !- Program Line 116
  Set clg_mode = 0,                       !- Program Line 117
  If (htg_load_cond > 0),                 !- Program Line 118
  Set htg_mode = 1.0,                     !- Program Line 119
  ElseIf (clg_load_cond > 0),             !- Program Line 120
  Set clg_mode = 0.2,                     !- Program Line 121
  Else,                                   !- Program Line 122
  Set htg_season = 0,                     !- Program Line 123
  Set clg_season = 0,                     !- Program Line 124
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 125
  Set clg_season = 1,                     !- Program Line 126
  EndIf,                                  !- Program Line 127
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 128
  Set htg_season = 1,                     !- Program Line 129
  EndIf,                                  !- Program Line 130
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 131
  Set clg_mode = 0.2,                     !- Program Line 132
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 133
  Set clg_mode = 0.2,                     !- Program Line 134

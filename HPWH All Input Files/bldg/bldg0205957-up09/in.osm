  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 140
  Set loads_htg_intgains = loads_htg_intgains + (hr_intgains * htg_mode * 1), !- Program Line 141
  Set loads_htg_lighting = loads_htg_lighting + (hr_lighting * htg_mode * 1), !- Program Line 142
  Set loads_htg_infil = loads_htg_infil + (hr_infil * htg_mode * 1), !- Program Line 143
  Set loads_htg_mechvent = loads_htg_mechvent + (hr_mechvent * htg_mode * 1), !- Program Line 144
  Set loads_htg_natvent = loads_htg_natvent + (hr_natvent * htg_mode * 1), !- Program Line 145
  Set loads_htg_whf = loads_htg_whf + (hr_whf * htg_mode * 1), !- Program Line 146
  Set loads_htg_ducts = loads_htg_ducts + (hr_ducts * htg_mode * 1), !- Program Line 147
  Set loads_clg_walls = loads_clg_walls + (-hr_walls * clg_mode * 1), !- Program Line 148

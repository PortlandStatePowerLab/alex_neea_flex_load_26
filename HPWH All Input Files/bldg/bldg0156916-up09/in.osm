  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 142
  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 143

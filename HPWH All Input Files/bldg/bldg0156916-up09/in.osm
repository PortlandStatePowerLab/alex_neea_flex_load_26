OS:EnergyManagementSystem:Actuator,
  {6dd04c8f-2973-481d-b798-514322461c1d}, !- Handle
  fridge_schedule_act,                    !- Name
  {f65f0827-143c-45dd-be00-e0c05c76b891}, !- Actuated Component Name

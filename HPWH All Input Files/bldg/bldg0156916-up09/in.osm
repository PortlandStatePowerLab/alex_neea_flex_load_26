  Set hr_intgains = 0,                    !- Program Line 90
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_ee_conv_5 - ig_ee_rad_5 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_ppl_conv - ig_ppl_rad, !- Program Line 91

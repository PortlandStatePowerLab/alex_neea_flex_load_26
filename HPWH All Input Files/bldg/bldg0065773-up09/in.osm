OS:EnergyManagementSystem:Actuator,
  {6a1c3f9d-1055-4f59-89e8-6a46f4a24645}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {d5424f12-7315-40d6-bb24-33a3f49e7186}, !- Actuated Component Name

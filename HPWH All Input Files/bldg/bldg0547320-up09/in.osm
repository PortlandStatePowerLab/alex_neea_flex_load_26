  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 72
  Set hr_windows_solar = 0,               !- Program Line 73
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 74
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_1 * ZoneTimestep * 3600 + ss_back_out_1 * ZoneTimestep * 3600 + ss_trans_out_1 * ZoneTimestep * 3600, !- Program Line 75
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_2 * ZoneTimestep * 3600 + ss_back_out_2 * ZoneTimestep * 3600 + ss_trans_out_2 * ZoneTimestep * 3600, !- Program Line 76
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_3 * ZoneTimestep * 3600 + ss_back_out_3 * ZoneTimestep * 3600 + ss_trans_out_3 * ZoneTimestep * 3600, !- Program Line 77

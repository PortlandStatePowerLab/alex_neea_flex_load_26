  Set hr_internal_mass = 0,               !- Program Line 86
  Set hr_internal_mass = hr_internal_mass + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 87
  Set hr_internal_mass = hr_internal_mass + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 88

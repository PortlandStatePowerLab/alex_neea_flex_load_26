OS:EnergyManagementSystem:Actuator,
  {5910e331-0fa8-4fe3-8780-6c2a84b16096}, !- Handle
  fridge_schedule_act,                    !- Name
  {0b2071ea-39f5-466e-9745-b312e08736bb}, !- Actuated Component Name

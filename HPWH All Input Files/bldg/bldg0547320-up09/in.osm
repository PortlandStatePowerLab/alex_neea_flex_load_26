  Set hr_roofs = hr_roofs + s_conv_7 + s_ig_7 + s_sol_7 + s_lgt_7 + s_surf_7, !- Program Line 59
  Set hr_windows_conduction = 0,          !- Program Line 60
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 61

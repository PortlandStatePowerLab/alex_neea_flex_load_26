OS:EnergyManagementSystem:Program,
  {ee1b5688-853d-465b-905c-b6dde48d07ec}, !- Handle
  water_heater_Control,                   !- Name
  Set water_heater_HPWHSchedOverride = water_heater_T_set, !- Program Line 1
  If (water_heater_amb_temp<5.56) || (water_heater_amb_temp>48.89), !- Program Line 2
  Set water_heater_UESchedOverride = water_heater_T_set, !- Program Line 3
  Set water_heater_LESchedOverride = water_heater_T_set, !- Program Line 4
  Else,                                   !- Program Line 5
  Set water_heater_UESchedOverride = water_heater_T_set - 9.0, !- Program Line 6
  Set water_heater_LESchedOverride = 0,   !- Program Line 7
  EndIf;                                  !- Program Line 8


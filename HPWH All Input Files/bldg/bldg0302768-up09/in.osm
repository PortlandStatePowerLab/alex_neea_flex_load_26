  Set loads_clg_windows_solar = loads_clg_windows_solar + (-hr_windows_solar * clg_mode * 1), !- Program Line 154
  Set loads_clg_doors = loads_clg_doors + (-hr_doors * clg_mode * 1), !- Program Line 155
  Set loads_clg_skylights_conduction = loads_clg_skylights_conduction + (-hr_skylights_conduction * clg_mode * 1), !- Program Line 156
  Set loads_clg_skylights_solar = loads_clg_skylights_solar + (-hr_skylights_solar * clg_mode * 1), !- Program Line 157

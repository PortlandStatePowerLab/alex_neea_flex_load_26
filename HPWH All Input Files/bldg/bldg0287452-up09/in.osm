  Set loads_clg_windows_solar = loads_clg_windows_solar + (-hr_windows_solar * clg_mode * 1), !- Program Line 156
  Set loads_clg_doors = loads_clg_doors + (-hr_doors * clg_mode * 1), !- Program Line 157

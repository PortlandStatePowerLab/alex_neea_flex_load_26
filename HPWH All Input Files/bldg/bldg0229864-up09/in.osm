  {c3e390df-1ae6-4ecc-9bcc-8ee4777c8242}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {7692eb1f-5566-4148-afef-29789aac3689}, !- Actuated Component Name

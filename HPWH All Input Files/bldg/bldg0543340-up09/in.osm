OS:EnergyManagementSystem:Actuator,
  {97b6924a-1eec-4211-9ea6-80e6c478700d}, !- Handle
  fridge_schedule_act,                    !- Name
  {921151ec-9279-46d3-810d-7ab8241cbe01}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {f44aa2e6-5ad7-4e30-b31f-6681a4f6a6eb}, !- Handle
  fridge_schedule_act,                    !- Name
  {0c0955ee-84be-4a69-a213-6ccae1c448cd}, !- Actuated Component Name

  Set hr_windows_conduction = hr_windows_conduction + ss_ig_4, !- Program Line 67
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 68
  Set hr_windows_solar = 0,               !- Program Line 69

OS:EnergyManagementSystem:Actuator,
  {bae2bbbc-dc9e-4a7f-b1da-8833d4f91bf6}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {7c56dcc3-de93-4daf-be62-12742033a962}, !- Actuated Component Name

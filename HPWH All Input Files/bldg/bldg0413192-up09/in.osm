  {a233a6cc-f9b6-4db3-b51d-f718a9a6f183}, !- Handle
  fridge_tin_s,                           !- Name
  conditioned space,                      !- Output Variable or Output Meter Index Key Name
  Zone Mean Air Temperature;              !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Actuator,
  {65a3ed7d-3dec-453b-bf69-1f4ff9b12dd0}, !- Handle
  fridge_schedule_act,                    !- Name
  {1e7d8350-b1a8-4e99-9c91-dc369a2e61fa}, !- Actuated Component Name
  Schedule:Constant,                      !- Actuated Component Type
  Schedule Value,                         !- Actuated Component Control Type
  ;                                       !- Zone or Space Name

OS:EnergyManagementSystem:Program,
  {c2dceb35-8512-43a6-b503-3f6649a9cc71}, !- Handle
  fridge_schedule_program,                !- Name
  Set Tin = fridge_tin_s*(9.0/5.0)+32.0,  !- Program Line 1
  Set fridge_schedule_act = 0,            !- Program Line 2
  If (Hour == 0),                         !- Program Line 3
  Set fridge_schedule_act = (-0.487+0.019*Tin), !- Program Line 4
  ElseIf (Hour == 1),                     !- Program Line 5
  Set fridge_schedule_act = (-0.34+0.016*Tin), !- Program Line 6
  ElseIf (Hour == 2),                     !- Program Line 7
  Set fridge_schedule_act = (-0.37+0.017*Tin), !- Program Line 8
  ElseIf (Hour == 3),                     !- Program Line 9
  Set fridge_schedule_act = (-0.361+0.016*Tin), !- Program Line 10
  ElseIf (Hour == 4),                     !- Program Line 11
  Set fridge_schedule_act = (-0.515+0.018*Tin), !- Program Line 12
  ElseIf (Hour == 5),                     !- Program Line 13
  Set fridge_schedule_act = (-0.684+0.021*Tin), !- Program Line 14
  ElseIf (Hour == 6),                     !- Program Line 15
  Set fridge_schedule_act = (-0.471+0.019*Tin), !- Program Line 16
  ElseIf (Hour == 7),                     !- Program Line 17
  Set fridge_schedule_act = (-0.159+0.015*Tin), !- Program Line 18
  ElseIf (Hour == 8),                     !- Program Line 19
  Set fridge_schedule_act = (-0.079+0.015*Tin), !- Program Line 20
  ElseIf (Hour == 9),                     !- Program Line 21

OS:EnergyManagementSystem:Program,
  {493357fd-4aab-4fd4-b287-f5d15554ef5a}, !- Handle
  infil_program,                          !- Name
  Set p_m = 0.14,                         !- Program Line 1
  Set p_s = 0.22,                         !- Program Line 2
  Set s_m = 270,                          !- Program Line 3
  Set s_s = 370,                          !- Program Line 4
  Set z_m = 9.99744,                      !- Program Line 5
  Set z_s = 4.8768,                       !- Program Line 6
  Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)), !- Program Line 7
  Set Tdiff = tin_s-tout_s,               !- Program Line 8
  Set dT = @Abs Tdiff,                    !- Program Line 9
  Set c = 0.1049,                         !- Program Line 10
  Set Cs = 0.0872,                        !- Program Line 11
  Set Cw = 0.1017,                        !- Program Line 12
  Set n = 0.65,                           !- Program Line 13
  Set sft = (f_t*0.5),                    !- Program Line 14
  Set temp1 = ((c*Cw)*((sft*site_vw_s)^(2*n)))^2, !- Program Line 15
  Set Qinf = (((c*Cs*(dT^n))^2)+temp1)^0.5, !- Program Line 16
  Set Qinf = (@Max Qinf 0),               !- Program Line 17
  Set mech_vent_house_fan_sensible_load_act = 0.0, !- Program Line 18
  Set mech_vent_house_fan_latent_load_act = 0.0, !- Program Line 19
  Set OASupInPb = out_pb_s,               !- Program Line 20
  Set OASupInTemp = tout_s,               !- Program Line 21
  Set OASupInW = out_wt_s,                !- Program Line 22
  Set OASupRho = (@RhoAirFnPbTdbW OASupInPb OASupInTemp OASupInW), !- Program Line 23
  Set OASupCp = (@CpAirFnW OASupInW),     !- Program Line 24
  Set OASupInEnth = (@HFnTdbW OASupInTemp OASupInW), !- Program Line 25
  Set ZoneTemp = tin_s,                   !- Program Line 26
  Set ZoneW = win_s,                      !- Program Line 27
  Set ZoneCp = (@CpAirFnW ZoneW),         !- Program Line 28
  Set ZoneAirEnth = (@HFnTdbW ZoneTemp ZoneW), !- Program Line 29
  Set mech_vent_house_fan_cfis_act = 0.0, !- Program Line 30
  Set QWHV_cfis_sup = 0.0,                !- Program Line 31
  Set QWHV_cfis_suppl_sup = 0.0,          !- Program Line 32
  Set QWHV_cfis_suppl_exh = 0.0,          !- Program Line 33
  Set Qrange = 0,                         !- Program Line 34
  Set Qrange = Qrange + 0.04719 * mech_vent_range_fan_0_sch_s, !- Program Line 35
  Set Qbath = 0,                          !- Program Line 36
  Set Qbath = Qbath + 0.04719 * mech_vent_bath_fan_0_sch_s, !- Program Line 37
  Set Qdryer = 0,                         !- Program Line 38
  Set Qdryer = Qdryer + 0.20023 * clothes_dryer_exhaust_0_sch_s, !- Program Line 39
  Set QWHV_sup = 0.0,                     !- Program Line 40
  Set QWHV_exh = 0.0,                     !- Program Line 41
  Set Qsupply = QWHV_sup + QWHV_cfis_sup + QWHV_cfis_suppl_sup, !- Program Line 42
  Set Qexhaust = Qrange + Qbath + Qdryer + QWHV_exh + QWHV_cfis_suppl_exh, !- Program Line 43
  Set Qfan = (@Max Qexhaust Qsupply),     !- Program Line 44
  Set Qducts = 0,                         !- Program Line 45
  Set Qducts = Qducts - furnace_airloop_0_DuctImbalLkSupFanEquivCond, !- Program Line 46
  Set Qducts = Qducts + furnace_airloop_0_DuctImbalLkExhFanEquivCond, !- Program Line 47
  If Qducts < 0,                          !- Program Line 48
  Set Qsupply = Qsupply - Qducts,         !- Program Line 49
  Else,                                   !- Program Line 50
  Set Qexhaust = Qexhaust + Qducts,       !- Program Line 51
  EndIf,                                  !- Program Line 52
  Set Qfan_with_ducts = (@Max Qexhaust Qsupply), !- Program Line 53
  Set Qimb = (@Abs (Qsupply - Qexhaust)), !- Program Line 54
  If Qinf + Qimb > 0,                     !- Program Line 55
  Set Qtot = Qfan_with_ducts + (Qinf^2) / (Qinf + Qimb), !- Program Line 56
  Else,                                   !- Program Line 57
  Set Qtot = Qfan_with_ducts,             !- Program Line 58
  EndIf,                                  !- Program Line 59
  Set Qinf_adj = Qtot - Qfan,             !- Program Line 60
  Set infil_flow_act = Qinf_adj,          !- Program Line 61
  Set infil_program_Qinf = Qinf_adj,      !- Program Line 62
  Set infil_program_Qfan = Qfan,          !- Program Line 63
  Set Qload = Qfan,                       !- Program Line 64
  Set Effectiveness_Sens = 0.0,           !- Program Line 65
  Set Effectiveness_Lat = 0.0,            !- Program Line 66
  Set Fan_MFR = Qload * OASupRho,         !- Program Line 67
  Set ZoneInEnth = OASupInEnth,           !- Program Line 68
  Set ZoneInTemp = OASupInTemp,           !- Program Line 69
  Set FanTotalToCond = Fan_MFR * (ZoneInEnth - ZoneAirEnth), !- Program Line 70
  Set FanSensToCond = Fan_MFR * ZoneCp * (ZoneInTemp - ZoneTemp), !- Program Line 71
  Set FanLatToCond = FanTotalToCond - FanSensToCond, !- Program Line 72
  Set mech_vent_house_fan_sensible_load_act = mech_vent_house_fan_sensible_load_act + FanSensToCond, !- Program Line 73
  Set mech_vent_house_fan_latent_load_act = mech_vent_house_fan_latent_load_act + FanLatToCond; !- Program Line 74


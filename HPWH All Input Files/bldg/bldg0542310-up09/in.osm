OS:EnergyManagementSystem:Actuator,
  {4c8ccb1a-bd17-409d-a0b5-88bebf7e83b8}, !- Handle
  fridge_schedule_act,                    !- Name
  {2012e665-cc6e-4a16-affd-616ffa633c8c}, !- Actuated Component Name

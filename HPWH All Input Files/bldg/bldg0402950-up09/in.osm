  {d6cda80c-f3f9-4e6b-8eea-a25ecfd8670b}, !- Handle
  fridge_schedule_act,                    !- Name
  {cf2cb2da-bdc5-435d-ae6a-4e416b6f3b44}, !- Actuated Component Name

OS:EnergyManagementSystem:Program,
  {b79d4192-4c00-4631-b1a7-1e3df125ad65}, !- Handle
  water_heater_hpwh_EC_adj,               !- Name
  If WarmupFlag == 0,                     !- Program Line 1
  Set dhw_e_cons = water_heater_tank_energy + water_heater_tank_on_cycle_parasitic + water_heater_tank_off_cycle_parasitic + water_heater_coil_energy + water_heater_fan_energy, !- Program Line 2
  Set water_heater_hpwh_ec_adj_act = 0.0 * dhw_e_cons / 1, !- Program Line 3
  EndIf;                                  !- Program Line 4


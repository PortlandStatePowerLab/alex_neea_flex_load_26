  Set clg_mode = 0.2,                     !- Program Line 120
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 121
  Set htg_mode = 1.0,                     !- Program Line 122
  EndIf,                                  !- Program Line 123
  EndIf,                                  !- Program Line 124
  EndIf,                                  !- Program Line 125
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 126

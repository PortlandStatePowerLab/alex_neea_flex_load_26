  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 108
  Set htg_season = 1,                     !- Program Line 109
  EndIf,                                  !- Program Line 110
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 111
  Set clg_mode = 0.2,                     !- Program Line 112
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 113

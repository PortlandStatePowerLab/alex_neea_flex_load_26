OS:EnergyManagementSystem:Program,
  {cc008389-d541-4657-a5e8-f637e7a9d629}, !- Handle
  fridge_schedule_1_program,              !- Name
  Set Tin = fridge_tin_s_1*(9.0/5.0)+32.0, !- Program Line 1
  Set fridge_schedule_1_act = 0,          !- Program Line 2
  If (Hour == 0),                         !- Program Line 3
  Set fridge_schedule_1_act = (-0.487+0.019*Tin), !- Program Line 4
  ElseIf (Hour == 1),                     !- Program Line 5
  Set fridge_schedule_1_act = (-0.34+0.016*Tin), !- Program Line 6
  ElseIf (Hour == 2),                     !- Program Line 7
  Set fridge_schedule_1_act = (-0.37+0.017*Tin), !- Program Line 8

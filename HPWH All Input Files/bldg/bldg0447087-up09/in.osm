  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 124
  Set clg_season = 1,                     !- Program Line 125
  EndIf,                                  !- Program Line 126
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 127
  Set htg_season = 1,                     !- Program Line 128
  EndIf,                                  !- Program Line 129
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 130
  Set clg_mode = 0.0,                     !- Program Line 131
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 132
  Set clg_mode = 0.0,                     !- Program Line 133

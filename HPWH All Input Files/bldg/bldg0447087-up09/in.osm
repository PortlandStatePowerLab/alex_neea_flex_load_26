  Set loads_htg_natvent = loads_htg_natvent + (hr_natvent * htg_mode * 1), !- Program Line 160
  Set loads_htg_whf = loads_htg_whf + (hr_whf * htg_mode * 1), !- Program Line 161
  Set loads_htg_ducts = loads_htg_ducts + (hr_ducts * htg_mode * 1), !- Program Line 162
  Set loads_clg_walls = loads_clg_walls + (-hr_walls * clg_mode * 1), !- Program Line 163

  {34c5ac1a-6801-4224-b7a8-8136e4ca6a96}, !- Handle
  {142e5aad-bec3-4d97-a8a4-f639e9f11321}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1

OS:EnergyManagementSystem:ProgramCallingManager,
  {a1373f82-40ee-4d51-a124-eaf090f54987}, !- Handle

OS:EnergyManagementSystem:Actuator,
  {1e866fab-7a99-4c5d-8fa3-0da62f585987}, !- Handle
  fridge_schedule_act,                    !- Name
  {c4423b08-1839-4cf0-bee7-2c12ea6c3c35}, !- Actuated Component Name

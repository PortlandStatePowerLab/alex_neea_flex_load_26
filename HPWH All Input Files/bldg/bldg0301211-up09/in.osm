  Set loads_clg_windows_conduction = loads_clg_windows_conduction + (-hr_windows_conduction * clg_mode * 1), !- Program Line 153
  Set loads_clg_windows_solar = loads_clg_windows_solar + (-hr_windows_solar * clg_mode * 1), !- Program Line 154

  String,                                 !- Feature Data Type 1
  infil;                                  !- Feature Value 1

OS:OtherEquipment:Definition,
  {ae7169f8-5b2b-4830-8811-470630208f13}, !- Handle
  mech vent house fan sensible load,      !- Name
  EquipmentLevel,                         !- Design Level Calculation Method

  {147a2603-6e1a-45e9-95aa-84174e6311f1}, !- Handle
  {cc209a96-1d3c-4bb4-93da-58544b40281d}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  unmet hours program;                    !- Feature Value 1


  Set loads_htg_windows_conduction = loads_htg_windows_conduction + (hr_windows_conduction * htg_mode * 1), !- Program Line 151
  Set loads_htg_windows_solar = loads_htg_windows_solar + (hr_windows_solar * htg_mode * 1), !- Program Line 152
  Set loads_htg_doors = loads_htg_doors + (hr_doors * htg_mode * 1), !- Program Line 153
  Set loads_htg_skylights_conduction = loads_htg_skylights_conduction + (hr_skylights_conduction * htg_mode * 1), !- Program Line 154
  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 155

OS:EnergyManagementSystem:Program,
  {23ecf3ca-bb86-49d4-aa9d-64838544f4bb}, !- Handle
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  Set loads_htg_tot = loads_htg_tot + (htg_load_duct - clg_load_duct) * 1.0, !- Program Line 5
  EndIf,                                  !- Program Line 6
  Set loads_htg_tot = (@Max loads_htg_tot 0), !- Program Line 7
  If clg_load_cond > 0,                   !- Program Line 8
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 0.0, !- Program Line 9
  Set loads_clg_tot = loads_clg_tot + (clg_load_duct - htg_load_duct) * 0.0, !- Program Line 10
  EndIf,                                  !- Program Line 11
  Set loads_clg_tot = (@Max loads_clg_tot 0); !- Program Line 12

OS:AdditionalProperties,
  {54882535-401f-45bd-8d76-cc287e32b851}, !- Handle
  {23ecf3ca-bb86-49d4-aa9d-64838544f4bb}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  total loads program;                    !- Feature Value 1


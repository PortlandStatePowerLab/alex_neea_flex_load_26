OS:EnergyManagementSystem:Program,
  {1e4b1ef0-9127-4dc2-92ca-1d9f9e42641a}, !- Handle
  mini_split_heat_pump_supply_fan_disaggregate_program, !- Name
  Set mini_split_heat_pump_supply_fan_clg = 0, !- Program Line 1
  Set mini_split_heat_pump_supply_fan_primary_htg = 0, !- Program Line 2
  Set mini_split_heat_pump_supply_fan_backup_htg = 0, !- Program Line 3
  If mini_split_heat_pump_clg_coil_s > 0, !- Program Line 4
  Set mini_split_heat_pump_supply_fan_clg = mini_split_heat_pump_supply_fan_s, !- Program Line 5
  ElseIf mini_split_heat_pump_htg_coil_s > 0 && (mini_split_heat_pump_backup_htg_coil_s > 0), !- Program Line 6
  Set mini_split_heat_pump_supply_fan_primary_htg = mini_split_heat_pump_supply_fan_s * mini_split_heat_pump_htg_coil_s / (mini_split_heat_pump_htg_coil_s + mini_split_heat_pump_backup_htg_coil_s), !- Program Line 7
  Set mini_split_heat_pump_supply_fan_backup_htg = mini_split_heat_pump_supply_fan_s * mini_split_heat_pump_backup_htg_coil_s / (mini_split_heat_pump_htg_coil_s + mini_split_heat_pump_backup_htg_coil_s), !- Program Line 8
  ElseIf mini_split_heat_pump_htg_coil_s > 0, !- Program Line 9
  Set mini_split_heat_pump_supply_fan_primary_htg = mini_split_heat_pump_supply_fan_s, !- Program Line 10
  Else,                                   !- Program Line 11

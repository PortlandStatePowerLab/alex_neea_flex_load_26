OS:EnergyManagementSystem:Actuator,
  {ff2ac172-1de8-4cc3-9af4-b166e617007f}, !- Handle
  fridge_schedule_act,                    !- Name
  {a65a533c-84d3-43b1-8e52-189dea9a207a}, !- Actuated Component Name

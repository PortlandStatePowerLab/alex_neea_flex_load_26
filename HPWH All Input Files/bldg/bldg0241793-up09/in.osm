OS:EnergyManagementSystem:Actuator,
  {0e5eeca2-1e62-4a11-8544-3382839efc48}, !- Handle
  fridge_schedule_act,                    !- Name
  {adaf303c-0981-4d60-aeef-cc7ed40fc8d3}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {870b4a8c-0491-4957-a64e-cf0c1c142baf}, !- Handle
  fridge_schedule_act,                    !- Name
  {67168c29-46ca-4bf4-a884-94ca2490748f}, !- Actuated Component Name

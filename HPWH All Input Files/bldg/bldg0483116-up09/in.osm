  Set hr_rim_joists = 0,                  !- Program Line 48
  Set hr_rim_joists = hr_rim_joists + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 49
  Set hr_rim_joists = hr_rim_joists + s_conv_4 + s_ig_4 + s_sol_4 + s_lgt_4 + s_surf_4, !- Program Line 50
  Set hr_rim_joists = hr_rim_joists + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 51
  Set hr_rim_joists = hr_rim_joists + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 52
  Set hr_foundation_walls = 0,            !- Program Line 53
  Set hr_foundation_walls = hr_foundation_walls + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 54
  Set hr_floors = 0,                      !- Program Line 55
  Set hr_slabs = 0,                       !- Program Line 56
  Set hr_slabs = hr_slabs + s_conv_8 + s_ig_8 + s_sol_8 + s_lgt_8 + s_surf_8, !- Program Line 57
  Set hr_ceilings = 0,                    !- Program Line 58
  Set hr_roofs = 0,                       !- Program Line 59
  Set hr_roofs = hr_roofs + s_conv_7 + s_ig_7 + s_sol_7 + s_lgt_7 + s_surf_7, !- Program Line 60
  Set hr_windows_conduction = 0,          !- Program Line 61
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 62
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_1, !- Program Line 63

  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 73
  Set hr_windows_solar = 0,               !- Program Line 74
  Set hr_windows_solar = hr_windows_solar - ss_trans_in * ZoneTimestep * 3600 + ss_back_out * ZoneTimestep * 3600 + ss_trans_out * ZoneTimestep * 3600, !- Program Line 75
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_1 * ZoneTimestep * 3600 + ss_back_out_1 * ZoneTimestep * 3600 + ss_trans_out_1 * ZoneTimestep * 3600, !- Program Line 76
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_2 * ZoneTimestep * 3600 + ss_back_out_2 * ZoneTimestep * 3600 + ss_trans_out_2 * ZoneTimestep * 3600, !- Program Line 77
  Set hr_windows_solar = hr_windows_solar - ss_trans_in_3 * ZoneTimestep * 3600 + ss_back_out_3 * ZoneTimestep * 3600 + ss_trans_out_3 * ZoneTimestep * 3600, !- Program Line 78
  Set hr_doors = 0,                       !- Program Line 79
  Set hr_doors = hr_doors + ss_sol,       !- Program Line 80
  Set hr_doors = hr_doors + ss_lgt,       !- Program Line 81
  Set hr_doors = hr_doors + ss_conv,      !- Program Line 82
  Set hr_doors = hr_doors + ss_ig,        !- Program Line 83
  Set hr_doors = hr_doors + ss_surf,      !- Program Line 84
  Set hr_skylights_conduction = 0,        !- Program Line 85

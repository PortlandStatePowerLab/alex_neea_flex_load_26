  Set hr_slabs = 0,                       !- Program Line 52
  Set hr_ceilings = 0,                    !- Program Line 53
  Set hr_ceilings = hr_ceilings + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 54

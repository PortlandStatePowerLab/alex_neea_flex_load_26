  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 96
  Set hr_ducts = 0,                       !- Program Line 97

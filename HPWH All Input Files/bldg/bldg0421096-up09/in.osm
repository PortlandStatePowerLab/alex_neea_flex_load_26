  ElseIf (clg_load_cond > 0),             !- Program Line 104
  Set clg_mode = 0.2,                     !- Program Line 105
  Else,                                   !- Program Line 106
  Set htg_season = 0,                     !- Program Line 107
  Set clg_season = 0,                     !- Program Line 108
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 109
  Set clg_season = 1,                     !- Program Line 110

  Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s, !- Program Line 3
  Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s_1, !- Program Line 4

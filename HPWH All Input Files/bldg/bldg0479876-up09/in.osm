  {877fd67f-a767-4afa-a8fd-e30b3ca48f9b}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {50959b44-27a6-4d23-abf5-2ad52da5e922}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {5706022e-137e-4164-83a3-ccf4f803bebf}, !- Handle
  fridge_schedule_act,                    !- Name
  {29377148-6a98-4964-b8ed-264ff6ad68db}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {acecccb4-5dab-48fd-8bea-e02bd7c07000}, !- Handle
  fridge_schedule_act,                    !- Name
  {481edf2c-985e-4ce4-8f43-01425c68e7ce}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {0a5983e6-29d6-405b-b553-ce51cb23621b}, !- Handle
  fridge_schedule_act,                    !- Name
  {6a7da06a-0079-45ee-99dc-c6f2fb747762}, !- Actuated Component Name

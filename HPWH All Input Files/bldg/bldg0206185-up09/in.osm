  Set htg_season = 0,                     !- Program Line 110
  Set clg_season = 0,                     !- Program Line 111
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 112
  Set clg_season = 1,                     !- Program Line 113
  EndIf,                                  !- Program Line 114
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 115
  Set htg_season = 1,                     !- Program Line 116
  EndIf,                                  !- Program Line 117
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 118
  Set clg_mode = 0.0,                     !- Program Line 119
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 120

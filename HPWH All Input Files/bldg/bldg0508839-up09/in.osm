OS:EnergyManagementSystem:Actuator,
  {d898cad4-c799-4131-a401-62d2491857f2}, !- Handle
  fridge_schedule_act,                    !- Name
  {0fb7b2cb-5909-4a75-a2ad-55560e13ba05}, !- Actuated Component Name

  {d134dfa8-ae79-4c8c-8f2a-7ff47897c291}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {d326ce9a-2b45-4c2a-9088-9e473a68f488}, !- Actuated Component Name

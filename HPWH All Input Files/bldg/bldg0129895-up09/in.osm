  Set loads_clg_natvent = 0,              !- Program Line 38
  Set loads_clg_whf = 0,                  !- Program Line 39
  Set loads_clg_ducts = 0,                !- Program Line 40
  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 43

  Set hr_mechvent = 0,                    !- Program Line 92
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3, !- Program Line 93
  Set hr_ducts = 0,                       !- Program Line 94
  Set hr_ducts = hr_ducts - ducts_conv - ducts_rad - ducts_conv_1 - ducts_rad_1 - ducts_conv_2 - ducts_rad_2 - ducts_conv_3 - ducts_rad_3 - ducts_conv_4 - ducts_rad_4 - ducts_conv_5 - ducts_rad_5, !- Program Line 95
  Set hr_ducts = hr_ducts + (duct_mix_loss_1 - duct_mix_gain_1), !- Program Line 96
  Set htg_mode = 0,                       !- Program Line 97
  Set clg_mode = 0,                       !- Program Line 98

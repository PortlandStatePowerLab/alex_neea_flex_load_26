  {7d1528c3-84ca-44f7-8277-09060cf349e3}, !- Handle
  water_heater_hpwh_ec_adj_act,           !- Name
  {f09e3df1-3aa8-43af-84d2-e1a8a8af61b4}, !- Actuated Component Name
  OtherEquipment,                         !- Actuated Component Type

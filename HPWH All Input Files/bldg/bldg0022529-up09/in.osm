OS:EnergyManagementSystem:Actuator,
  {671b2dc5-04fd-4b24-873a-e982c2613e33}, !- Handle
  fridge_schedule_act,                    !- Name
  {3de576bf-a425-462a-8b17-79725251e4c2}, !- Actuated Component Name

OS:EnergyManagementSystem:Actuator,
  {e9bac7ab-8886-4fd4-b6a2-9e3957be29ed}, !- Handle
  fridge_schedule_act,                    !- Name
  {9d50f2bd-5e64-46a5-bb75-93c207c384b0}, !- Actuated Component Name

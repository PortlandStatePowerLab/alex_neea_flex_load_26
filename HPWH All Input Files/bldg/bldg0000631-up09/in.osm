  Set hr_rim_joists = hr_rim_joists + s_conv_6 + s_ig_6 + s_sol_6 + s_lgt_6 + s_surf_6, !- Program Line 51
  Set hr_rim_joists = hr_rim_joists + s_conv_7 + s_ig_7 + s_sol_7 + s_lgt_7 + s_surf_7, !- Program Line 52

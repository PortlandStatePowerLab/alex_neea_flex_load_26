  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 94
  Set hr_mechvent = 0,                    !- Program Line 95
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 96
  Set hr_ducts = 0,                       !- Program Line 97
  Set hr_ducts = hr_ducts - ducts_conv - ducts_rad - ducts_conv_1 - ducts_rad_1 - ducts_conv_2 - ducts_rad_2 - ducts_conv_3 - ducts_rad_3 - ducts_conv_4 - ducts_rad_4 - ducts_conv_5 - ducts_rad_5, !- Program Line 98
  Set hr_ducts = hr_ducts + (duct_mix_loss_1 - duct_mix_gain_1), !- Program Line 99
  Set htg_mode = 0,                       !- Program Line 100
  Set clg_mode = 0,                       !- Program Line 101
  If (htg_load_cond > 0),                 !- Program Line 102
  Set htg_mode = 1.0,                     !- Program Line 103
  ElseIf (clg_load_cond > 0),             !- Program Line 104
  Set clg_mode = 1.0,                     !- Program Line 105
  Else,                                   !- Program Line 106
  Set htg_season = 0,                     !- Program Line 107
  Set clg_season = 0,                     !- Program Line 108
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 109
  Set clg_season = 1,                     !- Program Line 110
  EndIf,                                  !- Program Line 111
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 112
  Set htg_season = 1,                     !- Program Line 113
  EndIf,                                  !- Program Line 114
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 115
  Set clg_mode = 1.0,                     !- Program Line 116
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 117
  Set clg_mode = 1.0,                     !- Program Line 118
  Else,                                   !- Program Line 119
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 120
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 121
  Set clg_mode = 1.0,                     !- Program Line 122
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 123
  Set htg_mode = 1.0,                     !- Program Line 124
  EndIf,                                  !- Program Line 125
  EndIf,                                  !- Program Line 126
  EndIf,                                  !- Program Line 127
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 128

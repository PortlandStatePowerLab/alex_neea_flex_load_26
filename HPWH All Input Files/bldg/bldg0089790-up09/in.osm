OS:EnergyManagementSystem:Program,
  {0fe4f99f-63a7-4c84-abf1-281b3274f0ab}, !- Handle
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 7
  Set NVavail = natural_vent_s,           !- Program Line 8
  Set ClgSsnAvail = cool_season,          !- Program Line 9
  Set Qnv = 0,                            !- Program Line 10
  Set Qwhf = 0,                           !- Program Line 11
  Set whole_house_fan_act = 0,            !- Program Line 12
  If ((Wout < MaxHR) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 13
  Set WHF_Flow = 0,                       !- Program Line 14
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 15
  Set Adj = (@Min Adj 1),                 !- Program Line 16
  Set Adj = (@Max Adj 0),                 !- Program Line 17
  If (WHF_Flow > 0),                      !- Program Line 18
  Set Qwhf = WHF_Flow*Adj,                !- Program Line 19
  Set WHF_W = 0,                          !- Program Line 20
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 21
  ElseIf (NVavail > 0),                   !- Program Line 22
  Set NVArea = 7880.22165888,             !- Program Line 23
  Set Cs = 0.00017937135914540493,        !- Program Line 24
  Set Cw = 8.97707065726015e-05,          !- Program Line 25
  Set Tdiff = Tin-Tout,                   !- Program Line 26
  Set dT = (@Abs Tdiff),                  !- Program Line 27
  Set Vwind = site_vw_s,                  !- Program Line 28
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 29
  Set MaxNV = 3.3703340077056003,         !- Program Line 30
  Set Qnv = (@Min SGNV MaxNV),            !- Program Line 31
  EndIf,                                  !- Program Line 32
  EndIf,                                  !- Program Line 33
  Set natural_vent_flow_act = Qnv,        !- Program Line 34
  Set whole_house_fan_flow_act = Qwhf,    !- Program Line 35
  Set natural_vent_program_Qnv = Qnv,     !- Program Line 36
  Set natural_vent_program_Qwhf = Qwhf;   !- Program Line 37


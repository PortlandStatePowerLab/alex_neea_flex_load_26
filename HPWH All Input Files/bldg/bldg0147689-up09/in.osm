  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 123
  Set htg_mode = 1.0,                     !- Program Line 124
  EndIf,                                  !- Program Line 125
  EndIf,                                  !- Program Line 126
  EndIf,                                  !- Program Line 127

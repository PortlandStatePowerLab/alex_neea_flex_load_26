OS:EnergyManagementSystem:Actuator,
  {a432e563-ba6e-4b7d-bce2-470cd8835087}, !- Handle
  fridge_schedule_act,                    !- Name
  {db9ca397-f549-4f19-98f3-b94199441809}, !- Actuated Component Name

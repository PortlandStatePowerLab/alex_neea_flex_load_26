  Set central_ac_and_furnace_airloop_RA_T = central_ac_and_furnace_airloop_RA_T_s, !- Program Line 8
  Set central_ac_and_furnace_airloop_Ra_W = central_ac_and_furnace_airloop_Ra_W_s, !- Program Line 9
  Set central_ac_and_furnace_airloop_0_DZ_T = central_ac_and_furnace_airloop_0_DZ_T_s, !- Program Line 10
  Set central_ac_and_furnace_airloop_0_DZ_W = central_ac_and_furnace_airloop_0_DZ_W_s, !- Program Line 11
  Run central_ac_and_furnace_airloop_0_duct_subroutine, !- Program Line 12
  Set central_ac_and_furnace_airloop_0_SupSensLkToCond_act = central_ac_and_furnace_airloop_0_SupSensLkToCond, !- Program Line 13
  Set central_ac_and_furnace_airloop_0_SupLatLkToCond_act = central_ac_and_furnace_airloop_0_SupLatLkToCond, !- Program Line 14
  Set central_ac_and_furnace_airloop_0_SupCondToLv_act = central_ac_and_furnace_airloop_0_SupCondToLv, !- Program Line 15
  Set central_ac_and_furnace_airloop_0_RetSensLkToRP_act = central_ac_and_furnace_airloop_0_RetSensLkToRP, !- Program Line 16
  Set central_ac_and_furnace_airloop_0_RetLatLkToRP_act = central_ac_and_furnace_airloop_0_RetLatLkToRP, !- Program Line 17
  Set central_ac_and_furnace_airloop_0_RetCondToRP_act = central_ac_and_furnace_airloop_0_RetCondToRP, !- Program Line 18
  Set central_ac_and_furnace_airloop_0_RetCondToDZ_act = central_ac_and_furnace_airloop_0_RetCondToDZ, !- Program Line 19
  Set central_ac_and_furnace_airloop_0_SupCondToDZ_act = central_ac_and_furnace_airloop_0_SupCondToDZ, !- Program Line 20

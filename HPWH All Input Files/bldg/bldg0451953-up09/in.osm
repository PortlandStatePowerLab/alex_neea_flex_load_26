  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 115
  Set hr_mechvent = 0,                    !- Program Line 116
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 117
  Set hr_ducts = 0,                       !- Program Line 118
  Set htg_mode = 0,                       !- Program Line 119
  Set clg_mode = 0,                       !- Program Line 120
  If (htg_load_cond > 0),                 !- Program Line 121
  Set htg_mode = 1.0,                     !- Program Line 122
  ElseIf (clg_load_cond > 0),             !- Program Line 123

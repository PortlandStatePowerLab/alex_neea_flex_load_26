  Set hr_slabs = hr_slabs + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 50
  Set hr_ceilings = 0,                    !- Program Line 51
  Set hr_ceilings = hr_ceilings + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 52

  Set fridge_schedule_1_act = (-0.314+0.017*Tin), !- Program Line 30
  ElseIf (Hour == 14),                    !- Program Line 31
  Set fridge_schedule_1_act = (-0.16+0.015*Tin), !- Program Line 32
  ElseIf (Hour == 15),                    !- Program Line 33
  Set fridge_schedule_1_act = (-0.121+0.015*Tin), !- Program Line 34
  ElseIf (Hour == 16),                    !- Program Line 35

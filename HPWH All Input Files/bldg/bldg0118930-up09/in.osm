  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 99
  Set hr_mechvent = 0,                    !- Program Line 100
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3 - mv_conv_4 - mv_rad_4 - mv_conv_5 - mv_rad_5, !- Program Line 101
  Set hr_ducts = 0,                       !- Program Line 102
  Set htg_mode = 0,                       !- Program Line 103

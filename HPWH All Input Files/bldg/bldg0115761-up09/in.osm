  Set hr_internal_mass = 0,               !- Program Line 80
  Set hr_internal_mass = hr_internal_mass + im_conv + im_ig + im_sol + im_lgt + im_surf, !- Program Line 81
  Set hr_internal_mass = hr_internal_mass + im_conv_1 + im_ig_1 + im_sol_1 + im_lgt_1 + im_surf_1, !- Program Line 82
  Set hr_intgains = 0,                    !- Program Line 83
  Set hr_intgains = hr_intgains - ig_ee_conv - ig_ee_rad - ig_ee_conv_1 - ig_ee_rad_1 - ig_ee_conv_2 - ig_ee_rad_2 - ig_ee_conv_3 - ig_ee_rad_3 - ig_ee_conv_4 - ig_ee_rad_4 - ig_oe_conv - ig_oe_rad - ig_oe_conv_1 - ig_oe_rad_1 - ig_oe_conv_2 - ig_oe_rad_2 - ig_oe_conv_3 - ig_oe_rad_3 - ig_oe_conv_4 - ig_oe_rad_4 - ig_oe_conv_5 - ig_oe_rad_5 - ig_oe_conv_6 - ig_oe_rad_6, !- Program Line 84
  Set hr_lighting = 0,                    !- Program Line 85
  Set hr_infil = 0,                       !- Program Line 86
  Set hr_infil = hr_infil - airflow_gain + airflow_loss, !- Program Line 87
  Set hr_natvent = 0,                     !- Program Line 88
  Set hr_natvent = hr_natvent - airflow_gain_1 + airflow_loss_1, !- Program Line 89
  Set hr_whf = 0,                         !- Program Line 90
  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 91
  Set hr_mechvent = 0,                    !- Program Line 92
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3, !- Program Line 93
  Set hr_ducts = 0,                       !- Program Line 94
  Set hr_ducts = hr_ducts - ducts_conv - ducts_rad - ducts_conv_1 - ducts_rad_1 - ducts_conv_2 - ducts_rad_2 - ducts_conv_3 - ducts_rad_3 - ducts_conv_4 - ducts_rad_4 - ducts_conv_5 - ducts_rad_5, !- Program Line 95
  Set hr_ducts = hr_ducts + (duct_mix_loss_1 - duct_mix_gain_1), !- Program Line 96
  Set htg_mode = 0,                       !- Program Line 97
  Set clg_mode = 0,                       !- Program Line 98
  If (htg_load_cond > 0),                 !- Program Line 99
  Set htg_mode = 1.0,                     !- Program Line 100
  ElseIf (clg_load_cond > 0),             !- Program Line 101
  Set clg_mode = 0.0,                     !- Program Line 102
  Else,                                   !- Program Line 103
  Set htg_season = 0,                     !- Program Line 104
  Set clg_season = 0,                     !- Program Line 105
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 106
  Set clg_season = 1,                     !- Program Line 107
  EndIf,                                  !- Program Line 108
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 109
  Set htg_season = 1,                     !- Program Line 110
  EndIf,                                  !- Program Line 111
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 112
  Set clg_mode = 0.0,                     !- Program Line 113
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 114
  Set clg_mode = 0.0,                     !- Program Line 115
  Else,                                   !- Program Line 116
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 117
  If (tin_s_1 > Tmid_setpoint) && (clg_season == 1), !- Program Line 118
  Set clg_mode = 0.0,                     !- Program Line 119
  ElseIf (tin_s_1 < Tmid_setpoint) && (htg_season == 1), !- Program Line 120
  Set htg_mode = 1.0,                     !- Program Line 121
  EndIf,                                  !- Program Line 122
  EndIf,                                  !- Program Line 123
  EndIf,                                  !- Program Line 124
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 125
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 126
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 127

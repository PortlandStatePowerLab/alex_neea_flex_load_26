  Set loads_htg_windows_conduction = loads_htg_windows_conduction + (hr_windows_conduction * htg_mode * 1), !- Program Line 135
  Set loads_htg_windows_solar = loads_htg_windows_solar + (hr_windows_solar * htg_mode * 1), !- Program Line 136
  Set loads_htg_doors = loads_htg_doors + (hr_doors * htg_mode * 1), !- Program Line 137
  Set loads_htg_skylights_conduction = loads_htg_skylights_conduction + (hr_skylights_conduction * htg_mode * 1), !- Program Line 138
  Set loads_htg_skylights_solar = loads_htg_skylights_solar + (hr_skylights_solar * htg_mode * 1), !- Program Line 139
  Set loads_htg_internal_mass = loads_htg_internal_mass + (hr_internal_mass * htg_mode * 1), !- Program Line 140
  Set loads_htg_intgains = loads_htg_intgains + (hr_intgains * htg_mode * 1), !- Program Line 141
  Set loads_htg_lighting = loads_htg_lighting + (hr_lighting * htg_mode * 1), !- Program Line 142

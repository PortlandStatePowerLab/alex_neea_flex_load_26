  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 131
  Set htg_season = 1,                     !- Program Line 132
  EndIf,                                  !- Program Line 133
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 134
  Set clg_mode = 0.0,                     !- Program Line 135
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 136
  Set clg_mode = 0.0,                     !- Program Line 137

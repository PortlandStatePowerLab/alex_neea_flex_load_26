  {1330e674-bff4-4760-b2a6-49e773bfc5ef}, !- Handle
  {138f9b3d-5922-407d-8e53-e2203a5c02f7}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1


  Set loads_clg_skylights_conduction = 0, !- Program Line 31
  Set loads_clg_skylights_solar = 0,      !- Program Line 32
  Set loads_clg_internal_mass = 0,        !- Program Line 33
  Set loads_clg_intgains = 0,             !- Program Line 34
  Set loads_clg_lighting = 0,             !- Program Line 35
  Set loads_clg_infil = 0,                !- Program Line 36
  Set loads_clg_mechvent = 0,             !- Program Line 37
  Set loads_clg_natvent = 0,              !- Program Line 38
  Set loads_clg_whf = 0,                  !- Program Line 39
  Set loads_clg_ducts = 0,                !- Program Line 40
  Set hr_walls = 0,                       !- Program Line 41
  Set hr_walls = hr_walls + s_conv_2 + s_ig_2 + s_sol_2 + s_lgt_2 + s_surf_2, !- Program Line 42
  Set hr_walls = hr_walls + s_conv_3 + s_ig_3 + s_sol_3 + s_lgt_3 + s_surf_3, !- Program Line 43
  Set hr_walls = hr_walls + s_conv_4 + s_ig_4 + s_sol_4 + s_lgt_4 + s_surf_4, !- Program Line 44
  Set hr_walls = hr_walls + s_conv_5 + s_ig_5 + s_sol_5 + s_lgt_5 + s_surf_5, !- Program Line 45
  Set hr_rim_joists = 0,                  !- Program Line 46
  Set hr_foundation_walls = 0,            !- Program Line 47
  Set hr_floors = 0,                      !- Program Line 48
  Set hr_floors = hr_floors + s_conv + s_ig + s_sol + s_lgt + s_surf, !- Program Line 49
  Set hr_slabs = 0,                       !- Program Line 50
  Set hr_ceilings = 0,                    !- Program Line 51
  Set hr_ceilings = hr_ceilings + s_conv_1 + s_ig_1 + s_sol_1 + s_lgt_1 + s_surf_1, !- Program Line 52
  Set hr_roofs = 0,                       !- Program Line 53
  Set hr_windows_conduction = 0,          !- Program Line 54
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_1, !- Program Line 55
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_1, !- Program Line 56

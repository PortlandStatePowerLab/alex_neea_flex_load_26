OS:EnergyManagementSystem:Actuator,
  {68b99fda-d266-49e0-8be2-5e84cdc24e91}, !- Handle
  fridge_schedule_act,                    !- Name
  {b0649e96-6385-491e-b185-03cc78f01f89}, !- Actuated Component Name

  Set htg_mode = 1.0,                     !- Program Line 150
  EndIf,                                  !- Program Line 151
  EndIf,                                  !- Program Line 152
  EndIf,                                  !- Program Line 153
  Set loads_htg_walls = loads_htg_walls + (hr_walls * htg_mode * 1), !- Program Line 154
  Set loads_htg_rim_joists = loads_htg_rim_joists + (hr_rim_joists * htg_mode * 1), !- Program Line 155
  Set loads_htg_foundation_walls = loads_htg_foundation_walls + (hr_foundation_walls * htg_mode * 1), !- Program Line 156

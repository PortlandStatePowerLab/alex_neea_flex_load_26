  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 138
  Set htg_season = 1,                     !- Program Line 139
  EndIf,                                  !- Program Line 140
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 141
  Set clg_mode = 0.0,                     !- Program Line 142
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 143
  Set clg_mode = 0.0,                     !- Program Line 144
  Else,                                   !- Program Line 145
  Set Tmid_setpoint = (htg_sp_s_1 + clg_sp_s_1) / 2, !- Program Line 146

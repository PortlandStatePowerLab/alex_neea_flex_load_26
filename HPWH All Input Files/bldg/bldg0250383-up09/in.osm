  Set hr_whf = hr_whf - airflow_gain_2 + airflow_loss_2, !- Program Line 120
  Set hr_mechvent = 0,                    !- Program Line 121
  Set hr_mechvent = hr_mechvent - mv_conv - mv_rad - mv_conv_1 - mv_rad_1 - mv_conv_2 - mv_rad_2 - mv_conv_3 - mv_rad_3, !- Program Line 122
  Set hr_ducts = 0,                       !- Program Line 123

  Set hr_windows_solar = hr_windows_solar - ss_trans_in_9 * ZoneTimestep * 3600 + ss_back_out_9 * ZoneTimestep * 3600 + ss_trans_out_9 * ZoneTimestep * 3600, !- Program Line 98

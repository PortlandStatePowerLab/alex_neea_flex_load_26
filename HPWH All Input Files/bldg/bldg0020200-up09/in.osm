  {6dde88b2-0266-4fa1-88b8-4bfcd3e85496}, !- Handle
  {92d3dc40-64d5-47d2-b9f2-a149352acc55}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1


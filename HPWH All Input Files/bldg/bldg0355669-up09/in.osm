OS:EnergyManagementSystem:Program,
  {7a6c71a6-4105-4860-b426-8b8a3f257c5d}, !- Handle
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 7
  Set NVavail = natural_vent_s,           !- Program Line 8
  Set ClgSsnAvail = cool_season,          !- Program Line 9
  Set Qnv = 0,                            !- Program Line 10
  Set Qwhf = 0,                           !- Program Line 11
  Set whole_house_fan_mix_act = 0,        !- Program Line 12
  Set whole_house_fan_act = 0,            !- Program Line 13
  If ((Wout < MaxHR) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 14
  Set WHF_Flow = 0,                       !- Program Line 15
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 16
  Set Adj = (@Min Adj 1),                 !- Program Line 17
  Set Adj = (@Max Adj 0),                 !- Program Line 18
  If (WHF_Flow > 0),                      !- Program Line 19
  Set Qwhf = WHF_Flow*Adj,                !- Program Line 20
  Set whole_house_fan_mix_act = WHF_Flow*Adj, !- Program Line 21
  Set WHF_W = 0,                          !- Program Line 22
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 23
  ElseIf (NVavail > 0),                   !- Program Line 24
  Set NVArea = 9874.552637952002,         !- Program Line 25
  Set Cs = 0.00017937135914540493,        !- Program Line 26

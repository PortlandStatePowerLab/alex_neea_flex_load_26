OS:EnergyManagementSystem:Program,
  {44a90f13-a86f-4cb4-8629-b19412761f38}, !- Handle
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  EndIf,                                  !- Program Line 5
  Set loads_htg_tot = (@Max loads_htg_tot 0), !- Program Line 6
  If clg_load_cond > 0,                   !- Program Line 7
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 0.0, !- Program Line 8
  EndIf,                                  !- Program Line 9
  Set loads_clg_tot = (@Max loads_clg_tot 0); !- Program Line 10


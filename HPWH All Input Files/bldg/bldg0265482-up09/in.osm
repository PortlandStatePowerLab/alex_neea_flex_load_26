  crawlspace_unvented_1_duct_leakage_imbalance_infil_program, !- Name
  Set Qducts = 0,                         !- Program Line 1
  Set Qducts = Qducts - air_source_heat_pump_airloop_0_DuctImbalLkSupFanEquivDZ, !- Program Line 2
  Set Qducts = Qducts + air_source_heat_pump_airloop_0_DuctImbalLkExhFanEquivDZ, !- Program Line 3
  Set crawlspace_unvented_1_duct_leakage_imbalance_infil_flow_act = (@Abs(Qducts)); !- Program Line 4


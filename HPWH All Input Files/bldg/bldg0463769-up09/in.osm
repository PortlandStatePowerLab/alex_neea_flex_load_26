  Set hr_windows_conduction = hr_windows_conduction + ss_ig_3, !- Program Line 62
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_3, !- Program Line 63
  Set hr_windows_conduction = hr_windows_conduction + ss_conv_4, !- Program Line 64
  Set hr_windows_conduction = hr_windows_conduction + ss_ig_4, !- Program Line 65
  Set hr_windows_conduction = hr_windows_conduction + ss_surf_4, !- Program Line 66

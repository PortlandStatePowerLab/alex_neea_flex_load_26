  {726c029e-4f2d-4e2d-9d8f-24ba2997f621}, !- Handle
  {b64d03c4-4fa5-4eb3-898d-bddfd7651f8a}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  natural vent;                           !- Feature Value 1


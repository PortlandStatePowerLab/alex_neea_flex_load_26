OS:EnergyManagementSystem:Program,
  {0a4613bc-0099-4d77-8ba1-a8475c4b7174}, !- Handle
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  Set unit_htg_unmet_hours = 0,           !- Program Line 3
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 4
  Set unit_htg_unmet_hours = unit_htg_unmet_hours + conditioned_space_htg_unmet_s, !- Program Line 5
  If unit_htg_unmet_hours > htg_unmet_hours, !- Program Line 6
  Set htg_unmet_hours = unit_htg_unmet_hours, !- Program Line 7
  EndIf,                                  !- Program Line 8
  EndIf,                                  !- Program Line 9
  Set unit_clg_unmet_hours = 0,           !- Program Line 10
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 11
  Set unit_clg_unmet_hours = unit_clg_unmet_hours + conditioned_space_clg_unmet_s, !- Program Line 12
  If unit_clg_unmet_hours > clg_unmet_hours, !- Program Line 13
  Set clg_unmet_hours = unit_clg_unmet_hours, !- Program Line 14
  EndIf,                                  !- Program Line 15
  EndIf;                                  !- Program Line 16

OS:AdditionalProperties,
  {b03ad3b2-5dfd-4bad-9515-0b6a2e289781}, !- Handle

  Set fridge_schedule_1_act = (-0.077+0.014*Tin), !- Program Line 42
  ElseIf (Hour == 20),                    !- Program Line 43
  Set fridge_schedule_1_act = (-0.118+0.016*Tin), !- Program Line 44
  ElseIf (Hour == 21),                    !- Program Line 45

  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 112
  Set htg_season = 1,                     !- Program Line 113
  EndIf,                                  !- Program Line 114
  If ((airflow_gain_1 <> 0) || (airflow_loss_1 <> 0)) && (clg_season == 1), !- Program Line 115
  Set clg_mode = 0.8,                     !- Program Line 116
  ElseIf ((airflow_gain_2 <> 0) || (airflow_loss_2 <> 0)) && (clg_season == 1), !- Program Line 117
